# app.lux — Localify para Lux.
#
# Localify sobre el stack Lux:
# LuxScript + ventana nativa GTK/WebKit + HTTP loopback. La lógica de
# resolución (YouTube Music + MusicBrainz + yt-dlp) está reescrita en
# LuxScript; la reproducción de audio la hace un motor nativo (miniaudio +
# ffmpeg, src/audio_engine.cpp) que este backend manda por el módulo `audio`.

# Los imports son a nivel de proyecto: TODOS los módulos nativos usados por
# los demás .lux de este directorio se declaran aquí.
import sqlite
import window
import audio
import os
import time
import hash
import proc
import http
import math
import json

app:
    name      "Localify"
    host      "127.0.0.1"
    templates "./templates"
    static    "/static" -> "./public"

    window:
        title     "Localify"
        width     1280
        height    820
        resizable true
        icon      "./icon.png"

    sqlite:
        file "./data/localify.db"
        pool 4

get endpoint("/"):
    return render("index.html")
