# duplicados.lux — Una canción es una sola canción.
#
# Identidad: título + artista normalizados (las columnas title_norm/artist_norm
# de tracks) y, para no mezclar versiones distintas con el mismo nombre
# (single, radio edit, directo...), una duración compatible (±3 s; 0 =
# desconocida). El id de la pista NO es la identidad: la misma canción llega
# con ids distintos (otro vídeo de YouTube, una lista de Spotify importada, el
# servidor...) y sin esto acababa dos veces en la biblioteca, y descargada dos
# veces.
#
# Se evita al descargar (promover_cola / finalizar), al traer pistas del
# servidor (serverify.lux) y se puede arreglar lo ya existente con
# cmd_buscar_duplicados / cmd_fusionar_duplicados.

# Pista local equivalente a (título, artista, duración) distinta de `excepto`;
# "" si no hay. Prefiere la que ya tiene audio, luego favoritas, luego la más
# antigua. con_audio = true: solo cuenta una que ya esté descargada.
fn string equivalente_local(string tn, string an, int dur, string excepto, bool con_audio):
    if tn == "" or an == "":
        return ""
    List<Json> f = await sqlite.query("""
        select t.id,
               (select count(*) from audio_files af where af.track_id = t.id) as audio,
               (select count(*) from favorites fv where fv.track_id = t.id) as fav
        from tracks t
        where t.title_norm = ? and t.artist_norm = ? and t.id != ?
          and (t.duration_ms = 0 or ? = 0 or abs(t.duration_ms - ?) <= 3000)
        order by audio desc, fav desc, t.added_at asc limit 1
        """, tn, an, excepto, dur, dur)
    if len(f) == 0 or (con_audio and jint(f[0]["audio"], 0) == 0):
        return ""
    return jstr(f[0]["id"], "")

fn string equivalente_de(string tid, bool con_audio):
    List<Json> f = await sqlite.query("select title_norm, artist_norm, duration_ms from tracks where id = ?", tid)
    if len(f) == 0:
        return ""
    return equivalente_local(jstr(f[0]["title_norm"], ""), jstr(f[0]["artist_norm"], ""), jint(f[0]["duration_ms"], 0), tid, con_audio)

# Reemplaza `drop` por `keep` en todas partes (listas, favoritos, historial,
# letra, cola y reproductor) y borra `drop`. El audio se queda con `keep`: si
# keep no tenía, hereda el de drop; si los dos tenían, se borra el fichero de drop.
fn void fusionar_pistas(string keep, string drop):
    if keep == drop or keep == "" or drop == "":
        return
    await sqlite.exec("""
        delete from playlist_items where track_id = ?
          and playlist_id in (select playlist_id from playlist_items where track_id = ?)""", drop, keep)
    await sqlite.exec("update playlist_items set track_id = ? where track_id = ?", keep, drop)
    await sqlite.exec("insert or ignore into favorites(track_id, added_at) select ?, added_at from favorites where track_id = ?", keep, drop)
    await sqlite.exec("update play_history set track_id = ? where track_id = ?", keep, drop)
    await sqlite.exec("update or ignore lyrics set track_id = ? where track_id = ?", keep, drop)
    List<Json> audio = await sqlite.query("select rel_path from audio_files where track_id = ?", drop)
    if len(audio) > 0:
        List<Json> propio = await sqlite.query("select 1 from audio_files where track_id = ?", keep)
        if len(propio) == 0:
            await sqlite.exec("update audio_files set track_id = ? where track_id = ?", keep, drop)
            await sqlite.exec("delete from download_jobs where track_id = ?", keep)
        else:
            os.remove_file(ruta_audio_abs(jstr(audio[0]["rel_path"], "")))
    # reproductor y colas (los ids van entre comillas dentro del JSON)
    string a = "\"" + drop + "\""
    string b = "\"" + keep + "\""
    await sqlite.exec("""
        update player_state set
            track_id = case when track_id = ? then ? else track_id end,
            user_queue = replace(user_queue, ?, ?), context_queue = replace(context_queue, ?, ?),
            play_order = replace(play_order, ?, ?), history = replace(history, ?, ?),
            context = replace(context, ?, ?), revision = revision + 1
        where id = 1""", drop, keep, a, b, a, b, a, b, a, b, a, b)
    await sqlite.exec("delete from tracks where id = ?", drop)
    tocar_biblioteca()
    tocar_playlists()

# Tras terminar una descarga: cualquier otra copia de la misma canción se funde en esta.
fn void consolidar(string tid):
    for int i in range(0, 8):
        string otra = equivalente_de(tid, false)
        if otra == "":
            return
        fusionar_pistas(tid, otra)

# Grupos de duplicados de la biblioteca: [{ title, artist, keep, ids: [...] }]
fn List<Json> grupos_duplicados():
    List<Json> claves = await sqlite.query("""
        select title_norm, artist_norm from tracks
        where title_norm != '' and artist_norm != ''
        group by title_norm, artist_norm having count(*) > 1""")
    List<Json> out = []
    for int i in range(0, len(claves)):
        List<Json> ps = await sqlite.query("""
            select t.id, t.title, t.artist_display, t.duration_ms,
                   (select count(*) from audio_files af where af.track_id = t.id) as audio,
                   (select count(*) from favorites fv where fv.track_id = t.id) as fav
            from tracks t where t.title_norm = ? and t.artist_norm = ?
            order by t.duration_ms""", jstr(claves[i]["title_norm"], ""), jstr(claves[i]["artist_norm"], ""))
        # agrupar por duración compatible: mismo grupo si está a ≤ 3 s del primero
        # del grupo (o si alguna duración se desconoce)
        List<Json> actual = []
        int base = 0
        for int j in range(0, len(ps) + 1):
            bool corta = j == len(ps)
            if not corta and len(actual) > 0:
                int d = jint(ps[j]["duration_ms"], 0)
                corta = d != 0 and base != 0 and d - base > 3000
            if corta:
                if len(actual) > 1:
                    # keep: con audio, luego favorita
                    Json mejor = actual[0]
                    for int k in range(1, len(actual)):
                        int pm = jint(mejor["audio"], 0) * 2 + jint(mejor["fav"], 0)
                        int pk = jint(actual[k]["audio"], 0) * 2 + jint(actual[k]["fav"], 0)
                        if pk > pm:
                            mejor = actual[k]
                    List<string> ids = []
                    for int k in range(0, len(actual)):
                        ids.add(jstr(actual[k]["id"], ""))
                    out.add({ "title": jstr(mejor["title"], ""), "artist": jstr(mejor["artist_display"], ""),
                              "keep": jstr(mejor["id"], ""), "ids": ids })
                actual = []
                base = 0
            if j < len(ps):
                if len(actual) == 0:
                    base = jint(ps[j]["duration_ms"], 0)
                actual.add(ps[j])
    return out

fn Json cmd_fusionar_duplicados():
    List<Json> grupos = grupos_duplicados()
    int fusionadas = 0
    for int i in range(0, len(grupos)):
        string keep = jstr(grupos[i]["keep"], "")
        List<Json> ids = jlist(grupos[i]["ids"])
        for int k in range(0, len(ids)):
            if jstr(ids[k], "") != keep:
                fusionar_pistas(keep, jstr(ids[k], ""))
                fusionadas = fusionadas + 1
    return { "groups": len(grupos), "merged": fusionadas }

# ── Detección y fusión de duplicados (variante de arquitectura-nativa) ──────
fn string pista_equivalente(PistaCatalogo p):
    List<Json> por_video = await sqlite.query("""
        select track_id as id from audio_files where youtube_id = ? and track_id != ?
        union
        select track_id from youtube_matches
        where video_id = ? and track_id != ? and rejected = 0 and confidence = 'high'
        limit 1
        """, p.id, p.id, p.id, p.id)
    if len(por_video) > 0:
        return jstr(por_video[0]["id"], "")
    if p.duration_ms <= 0:
        return ""
    string artistas = ""
    for int i in range(0, len(p.artista_nombres)):
        artistas = artistas + (i > 0 ? ", " : "") + p.artista_nombres[i]
    List<Json> por_titulo = await sqlite.query("""
        select id from tracks
        where title_norm = ? and artist_norm = ? and abs(duration_ms - ?) <= 2000 and id != ?
        order by (select count(*) from play_history h where h.track_id = tracks.id) desc
        limit 1
        """, normalizar(p.title), normalizar(artistas), p.duration_ms, p.id)
    if len(por_titulo) > 0:
        return jstr(por_titulo[0]["id"], "")
    return ""

# ─── Fusionar las que ya existen ─────────────────────────────────────────────

# Lo que vale una copia: la que tiene el fichero, el "me gusta", está en una
# playlist o más se ha escuchado es la que se queda. A igualdad, la que NO es
# un id de vídeo (la de Spotify/MusicBrainz trae mejores metadatos).
fn int valor_de_pista(string id):
    List<Json> f = await sqlite.query("""
        select (select count(*) from audio_files a where a.track_id = ?) * 1000000
             + (select count(*) from favorites f where f.track_id = ?) * 100000
             + (select count(*) from playlist_items p where p.track_id = ?) * 10000
             + (select count(*) from play_history h where h.track_id = ?) * 10
             + (case when length(?) = 11 then 0 else 1 end) as v
        """, id, id, id, id, id)
    return jint(f[0]["v"], 0)

# Todo lo que apuntaba a `quita` pasa a `queda`, y `quita` desaparece.
fn void fusionar_pista(string queda, string quita):
    await sqlite.begin()
    await sqlite.exec("update play_history set track_id = ? where track_id = ?", queda, quita)
    await sqlite.exec("insert or ignore into favorites(track_id, added_at) select ?, added_at from favorites where track_id = ?", queda, quita)
    await sqlite.exec("delete from favorites where track_id = ?", quita)
    # En una playlist que ya tiene `queda`, la copia sobra; en las demás la sustituye.
    await sqlite.exec("""
        delete from playlist_items where track_id = ?
          and playlist_id in (select playlist_id from playlist_items where track_id = ?)
        """, quita, queda)
    await sqlite.exec("update playlist_items set track_id = ? where track_id = ?", queda, quita)
    # El fichero: si `queda` no tiene, se queda con el de `quita`.
    await sqlite.exec("update audio_files set track_id = ? where track_id = ? and not exists (select 1 from audio_files where track_id = ?)", queda, quita, queda)
    await sqlite.exec("update or ignore youtube_matches set track_id = ? where track_id = ?", queda, quita)
    await sqlite.exec("update or ignore lyrics set track_id = ? where track_id = ?", queda, quita)
    await sqlite.exec("update player_state set track_id = ? where track_id = ?", queda, quita)
    # La cola guarda ids dentro de JSON: se cambian como texto entre comillas.
    await sqlite.exec("""
        update player_state set
            context_queue = replace(context_queue, ?, ?),
            user_queue = replace(user_queue, ?, ?),
            history = replace(history, ?, ?)
        """, "\"" + quita + "\"", "\"" + queda + "\"", "\"" + quita + "\"", "\"" + queda + "\"",
        "\"" + quita + "\"", "\"" + queda + "\"")
    # El resto (track_artists, download_jobs, lo que no se pudo mover) cae con
    # la fila por ON DELETE CASCADE.
    await sqlite.exec("delete from tracks where id = ?", quita)
    await sqlite.commit()
    log.info("duplicados: " + quita + " fusionada en " + queda)

# Las parejas (a, b) que son la misma grabación, sin repetir.
fn List<Json> parejas_duplicadas():
    List<Json> por_video = await sqlite.query("""
        with enlaces(track_id, vid) as (
            select track_id, youtube_id from audio_files where youtube_id is not null
            union
            select track_id, video_id from youtube_matches where rejected = 0 and confidence = 'high'
        )
        select distinct e.track_id as a, v.id as b
        from enlaces e
        join tracks v on v.id = e.vid and v.id != e.track_id
        join track_artists ta on ta.track_id = e.track_id and ta.position = 0
        join artists aa on aa.id = ta.artist_id
        join track_artists tb on tb.track_id = v.id and tb.position = 0
        join artists ab on ab.id = tb.artist_id
        where aa.name_norm = ab.name_norm
        """)
    List<Json> por_titulo = await sqlite.query("""
        select a.id as a, b.id as b
        from tracks a join tracks b
          on a.title_norm = b.title_norm and a.artist_norm = b.artist_norm and a.id < b.id
        where a.title_norm != '' and abs(a.duration_ms - b.duration_ms) <= 2000
        """)
    return por_video + por_titulo

# Fusiona todas las parejas; devuelve cuántas filas desaparecieron. Barato con
# bibliotecas reales (unos cientos de pistas), así que corre en cada arranque.
fn int fusionar_duplicados():
    reparar_titulos_repetidos()
    int fusionadas = 0
    List<Json> parejas = parejas_duplicadas()
    for int i in range(0, len(parejas)):
        string a = jstr(parejas[i]["a"], "")
        string b = jstr(parejas[i]["b"], "")
        # Una pareja anterior pudo llevarse ya una de las dos.
        List<Json> vivas = await sqlite.query("select count(*) as n from tracks where id in (?, ?)", a, b)
        if jint(vivas[0]["n"], 0) < 2:
            continue
        if valor_de_pista(a) >= valor_de_pista(b):
            fusionar_pista(a, b)
        else:
            fusionar_pista(b, a)
        fusionadas = fusionadas + 1
    return fusionadas

# YouTube Music manda a veces el título dos veces ("X - X", una estilizada y
# otra en ASCII); guardar_pista ya solo toma la primera. Esto arregla las que
# entraron antes.
fn void reparar_titulos_repetidos():
    List<Json> f = await sqlite.query("select id, title from tracks where title like '% - %'")
    for int i in range(0, len(f)):
        string titulo = jstr(f[i]["title"], "")
        int corte = titulo.index_of(" - ")
        string izq = titulo.slice(0, corte).trim()
        string der = titulo.slice(corte + 3).trim()
        # Casi iguales, no idénticas: una lleva comillas tipográficas y "×", la
        # otra su versión ASCII.
        if izq != "" and similitud(normalizar(izq), normalizar(der)) >= 0.92:
            await sqlite.exec("update tracks set title = ?, title_norm = ? where id = ?", izq, normalizar(izq), jstr(f[i]["id"], ""))
