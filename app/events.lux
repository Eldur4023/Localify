# events.lux — Lo que el backend empuja a la interfaz, y sus tareas de fondo.
#
# Como en el original (bus de eventos → puente a la WebView), el backend
# EMPUJA: una tarea de fondo (motor_tick, cada 200 ms) fotografía el estado, y
# /api/events/stream (SSE) se lo manda a cada ventana abierta cuando cambia.
# La interfaz sigue sintetizando por diferencias los mismos eventos con los
# mismos nombres (ipc/transport.js), de modo que ninguna vista cambia.
#
# Ya no hay sondeo desde la página: WebKitGTK frena los temporizadores de una
# ventana minimizada o en la bandeja a varios segundos, y con el audio, las
# descargas y las integraciones colgando de ese sondeo, todo iba a su ritmo.
# Estas tareas viven en el servidor y no dependen de que la ventana esté a la
# vista.

# ─── Arranque ────────────────────────────────────────────────────────────────

# Lux no atiende ninguna petición hasta que acaba.
on start:
    db_init()
    int fusionadas = fusionar_duplicados()
    if fusionadas > 0:
        log.info("duplicados: " + str(fusionadas) + " pista(s) fusionada(s)")
    # La salida solo se reabre si hay una elegida: la predeterminada ya está.
    string salida = jstr(jget(jget(ajustes_estructurados(), "audio"), "outputDeviceId"), "")
    motor_aplicar_ajustes(salida != "")
    # Una app recién abierta no empieza a sonar sola: lo que quedó "sonando" al cerrarla se retoma
    # en pausa, en su posición. Aquí y no en la interfaz: va ANTES de cualquier sincronización con
    # otro equipo (si la interfaz lo pausaba después, pisaba el "sonando" que acababa de llegar).
    if en_movil() and leer_estado_ligero().status == "playing":
        mutar_estado("pause", "", "", -1)

# ─── Tareas de fondo ─────────────────────────────────────────────────────────

# El reproductor: avisos del motor, sincronizar, precargar, persistir, y la
# foto del estado para la interfaz.
every "200ms":
    motor_tick()

# Las descargas avanzan por ticks (downloads.lux).
every "1s":
    tick_descargas()

# Lo que baja del servidor común (hasta 120 s de timeout) en su propio bloque: no frena el tick.
every "1s":
    srv_descargas_tick()

# Serverify (red, puede tardar): aparte del tick de descargas.
every "1s":
    # Serverify: playlists reflejadas en la nube, como mucho una vez cada 30 s (o ya, si
    # alguien tocó una playlist: despachar borra la marca)
    if srv_activo() and state.incr("srv_rec", 1, 30000) == 1:
        srv_reconciliar()
    # y la biblioteca y los favoritos de la nube, cada 5 minutos (en segundo plano, sin avisar)
    if srv_activo() and ajuste("server_autopull", "1") == "1" and state.incr("srv_pull", 1, 300000) == 1:
        traer_nube()

# "Puede que te guste": trae una tanda nueva del catálogo cuando caduca
# (cada seis horas; recomendaciones.lux).
every "1m":
    recomendaciones_tick()
    sondeo_artistas_tick()

# Reproducción sincronizada entre equipos (sync.lux): envía lo pendiente y pregunta cada segundo.
every "500ms":
    sync_tick()

# ...y la escucha del otro equipo (petición larga) en su propio bloque.
every "1s":
    sync_escuchar_tick()

# Importaciones de discografía que se pidieron al abrir una ficha en el móvil:
# una por tick, en su propio bloque para que una importación lenta no retrase
# la sincronización ni el resto de tareas.
every "500ms":
    discografia_tick()

# La búsqueda remota pendiente (la escribe /api/invoke, la corre esto).
every "300ms":
    busquedas_remotas()

fn void busquedas_remotas():
    string rq = state.get("remote_query", "")
    if rq == "":
        return
    state.remove("remote_query")
    Json? trabajo = parse_json(rq)
    if trabajo != null:
        string q = jstr(trabajo["q"], "")
        if q != "":
            ytm_buscar_pistas(q, 15)
        state.set("remote_ready", str(jint(trabajo["queryId"], 0)))

# ─── La foto del estado ──────────────────────────────────────────────────────

fn Json construir_snapshot_de(EstadoCola e):
    # Una búsqueda remota que acaba de terminar se anuncia en UNA foto.
    List<Json> ready = []
    string rr = state.get("remote_ready", "")
    if rr != "":
        state.set("remote_ready", "")
        ready.add({ "queryId": int(rr) })

    # (ajuste() va por la caché de `state`: sin consulta a SQLite por foto)
    string s_lib = ajuste("stamp_library", "")
    string s_pl = ajuste("stamp_playlists", "")
    string s_aj = ajuste("stamp_settings", "")
    string s_pl_kind = ajuste("playlists_change_kind", "")

    return {
        "revision": e.revision,
        "trackId": e.track_id,
        "status": e.status,
        "volume": e.volume,
        "repeat": e.repeat_mode,
        "shuffle": e.shuffle,
        "libraryPath": biblioteca_raiz(),
        "libraryStamp": s_lib,
        "playlistStamp": s_pl,
        "playlistChangeKind": s_pl_kind,
        "settingsStamp": s_aj,
        "statsStamp": state.get("stamp_stats", ""),
        "syncSeek": state.get("sync_seek", ""),
        "downloads": descargas_activas(),
        "remoteReady": ready,
        "estado": estado_dto_de(e)
    }

fn Json construir_snapshot():
    return construir_snapshot_de(leer_estado_ligero())

# Guarda la foto si cambió; los flujos SSE miran `snap_seq`, que es memoria.
fn void publicar_snapshot_de(EstadoCola e):
    string txt = str(construir_snapshot_de(e))
    state.set("snap_suena", e.status == "playing" ? "1" : "0")
    if txt != state.get("snap_txt", ""):
        state.set("snap_txt", txt)
        state.incr("snap_seq")

fn void publicar_snapshot():
    publicar_snapshot_de(leer_estado_ligero())

# Una ventana abierta: al conectar recibe la foto actual (también al
# reconectar), y luego cada cambio.
sse endpoint("/api/events/stream"):
    int visto = 0
    # En el móvil no hay 5 fotos/s: el <audio> mueve la barra por su cuenta y
    # despertar el flujo 20 veces por segundo solo gasta batería.
    int rapida = en_movil() ? 200 : 50
    int espera = rapida
    int quieto = 0     # ms seguidos sin foto nueva
    int desde_ping = 0
    while sse.open:
        int seq = state.get("snap_seq", 0)
        if seq != visto:
            visto = seq
            quieto = 0
            sse.send("snapshot", state.get("snap_txt", "{}"))
        # En pausa y sin cambios desde hace 5 s no hace falta despertar 20 (5 en móvil) veces por
        # segundo: se espacia (la primera foto tras un cambio llega con ese retraso como mucho).
        espera = (quieto > 5000 and state.get("snap_suena", "0") != "1") ? (en_movil() ? 1000 : 250) : rapida
        await sleep(espera)
        quieto = quieto + espera
        desde_ping = desde_ping + espera
        if desde_ping >= 15000:
            desde_ping = 0
            sse.ping("keepalive")

# Diálogo nativo de fichero: lo resuelve la propia ventana GTK. Solo se llama
# desde la UI (es decir, con ventana viva).
post endpoint("/api/native/open-file"):
    string ruta = await window.open_file()
    return { "path": ruta }

# El shell de escritorio espera a que esto no sea un 503 antes de abrir la
# ventana (desktop_common.cpp, wait_for_server).
get endpoint("/api/ready"):
    return { "ok": true }
