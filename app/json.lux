# json.lux — Puente sobre el módulo nativo `json` (import json, app.lux).
#
# Hasta ahora el motor Lux tenía un parser JSON en C++ (ya usado
# internamente para el body de las requests, los JWT y las respuestas de
# http.*) pero no lo exponía a LuxScript, así que este archivo era ~340
# líneas de un parser JSON escrito a mano en el propio lenguaje -- con una
# tabla de caracteres ASCII/Latin-1 para resolver \uXXXX porque el lenguaje
# no tiene chr()/ord(), y que además degeneraba a '?' para cualquier
# codepoint fuera de esa tabla (emojis, escrituras no latinas escapadas).
#
# Con `json.parse`/`json.stringify` ya nativos (motor Lux,
# src/lux_script/modules/base_modules/json.cpp) este archivo se reduce a los
# adaptadores de acceso tolerante que el resto de la app ya usa -- y de paso
# se arregla la degradación de codepoints, gratis, al dejar de pasar por la
# tabla hecha a mano.
#
# parse_json(s) conserva la convención previa -- null tanto si el JSON es
# inválido como si el documento entero es el literal `null` -- para no tener
# que tocar ninguna de las llamadas existentes que ya asumen "null = no se
# pudo parsear" (queue.lux, downloads.lux, ytmusic.lux, musicbrainz.lux...).
# El módulo nativo SÍ distingue los dos casos (lanza en un fallo real, en
# vez de devolver null; ver json.cpp) para quien necesite esa distinción
# directamente, con `json.parse(s)` + try/catch en el sitio de la llamada.
fn Json? parse_json(string s):
    try:
        return json.parse(s)
    catch e:
        return null

# ─── Acceso tolerante a valores dinámicos ────────────────────────────────────

fn Json jget(Json j, string key):
    if j == null:
        return null
    return j[key]

fn List<Json> jlist(Json j):
    if j == null:
        return []
    return j

fn string jstr(Json j, string def):
    if j == null:
        return def
    return str(j)

fn int jint(Json j, int def):
    if j == null:
        return def
    return int(j)

fn double jdbl(Json j, double def):
    if j == null:
        return def
    # ffprobe manda sus campos numéricos (format.duration incluido) como
    # string JSON ("355.031000"), no como número -- "j * 1.0" explota ahí
    # con "arithmetic between string and float". Pasar por str()+parse_json()
    # normaliza los dos casos (string numérico y número de verdad) por la
    # misma ruta sin necesitar saber de antemano cuál llegó.
    Json? n = parse_json(str(j))
    if n == null:
        return def
    return n * 1.0
