# library.lux — Consulta canónica de "fila de pista" y utilidades que
# reutilizan player/queue/search/playlists.
#
# Las rutas REST /api/library/* que vivían aquí (puerto directo de
# crates/localify-app/src/commands/library.rs) nunca las llama el frontend:
# la UI habla enteramente por /api/invoke (api_comandos.lux/api_invoke.lux
# tienen su propia implementación de cada comando library_*, con sus propios
# DTOs). Mantenerlas vivas aquí sólo duplicaba lógica — ya habían divergido
# del original en algún sitio (el orden de "artista" en una, no en la otra).
# Lo único que sí usa código vivo es lo que queda: la consulta canónica de
# pista y pista_por_id/pistas_por_ids (player.lux las llama).

# ─── Consulta canónica de pistas ─────────────────────────────────────────────

fn string sql_pista():
    return """
    select t.id, t.title, t.album_id, al.title as album_title, t.duration_ms,
           t.track_number, t.disc_number, t.explicit, t.artist_display, t.added_at,
           case when af.track_id is null then 0 else 1 end as available,
           case when f.track_id is null then 0 else 1 end as favorite,
           coalesce(hp.cnt, 0) as play_count
    from tracks t
    left join albums al on al.id = t.album_id
    left join audio_files af on af.track_id = t.id
    left join favorites f on f.track_id = t.id
    left join (select track_id, count(*) as cnt from play_history group by track_id) hp on hp.track_id = t.id
    """ + " "

# mapear_pista: fila SQL → DTO camelCase del frontend.
fn Json mapear_pista(Json f):
    return {
        "id": jstr(f["id"], ""),
        "title": jstr(f["title"], ""),
        "albumId": jstr(f["album_id"], ""),
        "albumTitle": jstr(f["album_title"], ""),
        "durationMs": jint(f["duration_ms"], 0),
        "trackNumber": jint(f["track_number"], 0),
        "discNumber": jint(f["disc_number"], 1),
        "explicit": jint(f["explicit"], 0) == 1,
        "artistDisplay": jstr(f["artist_display"], ""),
        "addedAt": jint(f["added_at"], 0),
        "available": jint(f["available"], 0) == 1,
        "favorite": jint(f["favorite"], 0) == 1,
        "playCount": jint(f["play_count"], 0)
    }

fn List<Json> mapear_pistas(List<Json> filas):
    List<Json> out = []
    for int i in range(0, len(filas)):
        out.add(mapear_pista(filas[i]))
    return out

fn Json pista_por_id(string id):
    List<Json> filas = await sqlite.query(sql_pista() + " where t.id = ?", id)
    if len(filas) == 0:
        return null
    return mapear_pista(filas[0])

# pistas_por_ids conserva el orden de la lista de ids.
fn List<Json> pistas_por_ids(List<string> ids):
    List<Json> out = []
    for int i in range(0, len(ids)):
        Json p = pista_por_id(ids[i])
        if p != null:
            out.add(p)
    return out
