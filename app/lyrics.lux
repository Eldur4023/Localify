# lyrics.lux — Letras vía LRCLIB, con caché positiva y negativa.
#
# Puerto de crates/localify-integrations/src/letras.rs: un fallo de RED no
# marca negativo (podría ser transitorio); solo una respuesta vacía real.
# Ok(null) no es error: la UI simplemente oculta el panel.

get endpoint("/api/lyrics/:id", string id):
    db_init()
    List<Json> f = await sqlite.query("select synced, plain, not_found from lyrics where track_id = ?", id)
    if len(f) > 0:
        if jint(f[0]["not_found"], 0) == 1:
            return { "found": false }
        return {
            "found": true,
            "synced": jstr(f[0]["synced"], ""),
            "plain": jstr(f[0]["plain"], "")
        }
    List<Json> t = await sqlite.query("""
        select t.title, t.duration_ms, t.artist_display, ar.name as artist
        from tracks t left join track_artists ta on ta.track_id = t.id and ta.position = 0
        left join artists ar on ar.id = ta.artist_id
        where t.id = ?
        """, id)
    if len(t) == 0:
        return { "found": false }
    string titulo = jstr(t[0]["title"], "")
    string artista = jstr(t[0]["artist"], "")
    if artista == "":
        artista = jstr(t[0]["artist_display"], "")
        if artista.contains(","):
            artista = artista.slice(0, artista.index_of(",")).trim()
    int dur_ms = jint(t[0]["duration_ms"], 0)
    if titulo == "" or artista == "":
        return { "found": false }

    Dict<string, string> cabeceras = { "User-Agent": "Localify-Lux/1.0 (music player)" }
    Json? r = null
    try:
        r = await http.get("https://lrclib.net/api/get?artist_name=" + http.url_encode(artista) + "&track_name=" + http.url_encode(titulo) + "&duration=" + str(int(dur_ms / 1000)), cabeceras)
    catch e:
        return { "found": false }
    if r == null:
        return { "found": false }
    if jint(jget(r, "status"), 0) != 200:
        await sqlite.exec("insert or replace into lyrics(track_id, not_found, fetched_at) values(?, 1, unixepoch())", id)
        return { "found": false }
    Json body = jget(r, "body")
    string synced = jstr(body["syncedLyrics"], "")
    string plain = jstr(body["plainLyrics"], "")
    if synced == "" and plain == "":
        await sqlite.exec("insert or replace into lyrics(track_id, not_found, fetched_at) values(?, 1, unixepoch())", id)
        return { "found": false }
    await sqlite.exec("""
        insert into lyrics(track_id, synced, plain, source, fetched_at) values(?, ?, ?, 'lrclib', unixepoch())
        on conflict(track_id) do update set synced = excluded.synced, plain = excluded.plain, not_found = 0, fetched_at = excluded.fetched_at
        """, id, synced, plain)
    return { "found": true, "synced": synced, "plain": plain }
