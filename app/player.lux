# player.lux — Rutas REST del reproductor y servicio de audio.
#
# La interfaz habla por /api/invoke; estas rutas son para quien no es la
# interfaz: el menú nativo y la bandeja (window.lux, "action" = una ruta), y
# el relé de MPRIS (mpris.cpp). Todas entran por reproductor_orden()
# (reproductor.lux), la misma puerta que la interfaz, así que hacen
# exactamente lo mismo: mutar, anotar la escucha, publicar y despertar la
# ventana. El audio se sirve por /audio/:id (send_file soporta Range/206,
# así que saltar de posición funciona).

fn List<string> ids_de_filas(List<Json> filas):
    List<string> out = []
    for int i in range(0, len(filas)):
        out.add(jstr(filas[i]["id"], ""))
    return out

# Descargas activas resumidas (para que la UI muestre progreso).
fn List<Json> descargas_activas():
    List<Json> f = await sqlite.query("""
        select j.track_id, j.state, j.priority, j.bytes_done, j.bytes_total, j.video_id,
               j.last_error, j.attempts,
               t.title, t.artist_display, t.duration_ms
        from download_jobs j join tracks t on t.id = j.track_id
        where j.state in ('queued','matching','downloading','finalizing')
        order by j.priority, j.updated_at
        """)
    List<Json> out = []
    for int i in range(0, len(f)):
        Json r = f[i]
        int hecho = jint(r["bytes_done"], 0)
        int total = jint(r["bytes_total"], 0)
        int pct = 0
        if total > 0:
            pct = int((hecho * 100.0) / total)
        out.add({
            "trackId": jstr(r["track_id"], ""),
            "state": jstr(r["state"], ""),
            "priority": jstr(r["priority"], ""),
            "bytesDone": hecho,
            "bytesTotal": total,
            "percent": pct,
            "attempts": jint(r["attempts"], 0),
            "lastError": jstr(r["last_error"], ""),
            "title": jstr(r["title"], ""),
            "artistDisplay": jstr(r["artist_display"], ""),
            "durationMs": jint(r["duration_ms"], 0)
        })
    return out

# ─── Órdenes desde fuera de la ventana ───────────────────────────────────────

post endpoint("/api/player/toggle"):
    db_init()
    return reproductor_orden("toggle", {})

post endpoint("/api/player/pause"):
    db_init()
    return reproductor_orden("pause", {})

post endpoint("/api/player/resume"):
    db_init()
    return reproductor_orden("resume", {})

post endpoint("/api/player/next"):
    db_init()
    return reproductor_orden("next", {})

post endpoint("/api/player/previous"):
    db_init()
    return reproductor_orden("previous", {})

class PeticionSeek:
    int? positionMs

post endpoint("/api/player/seek", PeticionSeek p):
    db_init()
    return reproductor_orden("seek", { "positionMs": p.positionMs == null ? 0 : p.positionMs })

# ─── Servicio de audio ───────────────────────────────────────────────────────

fn string mime_audio(string formato):
    if formato == "opus" or formato == "ogg":
        return "audio/ogg"
    if formato == "webm":
        return "audio/webm"
    if formato == "m4a":
        return "audio/mp4"
    if formato == "mp3":
        return "audio/mpeg"
    if formato == "flac":
        return "audio/flac"
    if formato == "wav":
        return "audio/wav"
    return "application/octet-stream"

get endpoint("/audio/:id", string id):
    db_init()
    List<Json> f = await sqlite.query("select rel_path, format from audio_files where track_id = ?", id)
    if len(f) == 0:
        return status(404)
    string rel = jstr(f[0]["rel_path"], "")
    string abs = ruta_audio_abs(rel)
    if not os.is_file(abs):
        return status(404)
    header("Content-Type", mime_audio(jstr(f[0]["format"], "")))
    header("Accept-Ranges", "bytes")
    return send_file(abs, biblioteca_raiz())
