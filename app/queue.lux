# queue.lux — Dominio de la cola de reproducción.
#
# Puerto del modelo de DOS colas de Localify (crates/localify-core/src/domain/
# queue.rs + actors/cola.rs):
#   - cola de usuario ("reproducir a continuación" / "añadir a la cola"):
#     prioridad absoluta, se consume al reproducirse y sobrevive a cambios
#     de contexto;
#   - cola de contexto (álbum/playlist/búsqueda): se regenera al cambiar el
#     contexto; el orden de reproducción es una permutación estable cuando
#     shuffle está activo.
#
# Todo el estado vive en la fila única de player_state (SQLite): es la única
# memoria compartida segura entre las 16 hebras del servidor. Las mutaciones
# usan la columna revision como cerrojo optimista.

# Los imports de módulos son a nivel de proyecto y viven en app.lux.

# ─── PRNG reproducible (sin operadores bit a bit en el lenguaje) ─────────────
# LCG clásico mod 2^31: misma semilla → misma permutación, suficiente para
# barajar. (El original usaba xorshift64*; LuxScript no tiene <<, ^ ni >>.)

fn int prng_siguiente(int estado):
    # (estado * 1103515245 + 12345) mod 2^31: el producto cabe en int64
    # (2^31 * 2^30.04 < 2^62) así que no hace falta partir la multiplicación
    return (estado * 1103515245 + 12345) % 2147483648

fn List<int> permutacion_estable(int longitud, int semilla):
    List<int> indices = []
    for int i in range(0, longitud):
        indices.add(i)
    if longitud < 2:
        return indices
    int estado = semilla % 2147483647
    if estado <= 0:
        estado = 987654321
    for int i in range(longitud - 1, 0, -1):
        estado = prng_siguiente(estado)
        int j = estado % (i + 1)
        int tmp = indices[i]
        indices[i] = indices[j]
        indices[j] = tmp
    return indices

# ─── Lectura del estado ──────────────────────────────────────────────────────

class Entrada:
    string entryId
    string trackId

    Entrada(string entryId, string trackId)

class EstadoCola:
    string track_id
    int position_ms
    double volume
    string status
    string repeat_mode
    bool shuffle
    int shuffle_seed
    string context
    List<string> context_queue
    List<int> play_order
    int queue_index
    List<Entrada> user_queue
    List<string> history
    int revision
    # Ver motor.lux: cada cue es una orden "carga/colócate aquí" que el motor
    # de audio aplica una sola vez.
    int cue
    # ligero: leído sin las listas (leer_estado_ligero): guardar_estado solo
    # escribe los escalares, nunca pisa las listas con vacías.
    bool ligero
    # Las listas pesadas (cola de contexto + orden) solo se reescriben si un
    # mutador las tocó: pausar/volumen/avanzar no deben reescribir 20k ids.
    bool ctx_sucio

fn List<string> parsear_ids(string json_texto):
    List<string> out = []
    if json_texto == "" or json_texto == null:
        return out
    Json? j = parse_json(json_texto)
    if j == null:
        return out
    List<Json> items = jlist(j)
    for int i in range(0, len(items)):
        out.add(jstr(items[i], ""))
    return out

fn List<Entrada> parsear_entries(string json_texto):
    List<Entrada> out = []
    if json_texto == "" or json_texto == null:
        return out
    Json? j = parse_json(json_texto)
    if j == null:
        return out
    List<Json> items = jlist(j)
    for int i in range(0, len(items)):
        out.add(Entrada(jstr(items[i]["entryId"], ""), jstr(items[i]["trackId"], "")))
    return out

fn List<int> parsear_orden(string json_texto):
    List<int> out = []
    if json_texto == "" or json_texto == null:
        return out
    Json? j = parse_json(json_texto)
    if j == null:
        return out
    List<Json> items = jlist(j)
    for int i in range(0, len(items)):
        out.add(jint(items[i], 0))
    return out

fn EstadoCola estado_de_fila(Json f, int nivel):
    EstadoCola e = EstadoCola("", 0, 1.0, "stopped", "off", false, 0, "null", [], [], 0, [], [], 0, 0, nivel == 2, false)
    e.track_id = jstr(f["track_id"], "")
    e.position_ms = jint(f["position_ms"], 0)
    e.volume = jdbl(f["volume"], 1.0)
    e.status = jstr(f["status"], "stopped")
    e.repeat_mode = jstr(f["repeat_mode"], "off")
    e.shuffle = jint(f["shuffle"], 0) == 1
    e.shuffle_seed = jint(f["shuffle_seed"], 0)
    e.context = jstr(f["context"], "null")
    e.queue_index = jint(f["queue_index"], 0)
    e.revision = jint(f["revision"], 0)
    e.cue = jint(f["cue"], 0)
    if nivel == 0:
        e.context_queue = parsear_ids(jstr(f["context_queue"], ""))
        e.play_order = parsear_orden(jstr(f["play_order"], ""))
    if nivel < 2:
        e.user_queue = parsear_entries(jstr(f["user_queue"], ""))
        e.history = parsear_ids(jstr(f["history"], ""))
    return e

# Lectura completa: parsea las listas (la cola de contexto de una biblioteca
# grande son miles de ids). Solo para quien las necesita: mutar la cola,
# precargar la siguiente, publicar la ventana de sync, devolver la cola.
fn EstadoCola leer_estado():
    List<Json> filas = await sqlite.query("select track_id, position_ms, volume, status, repeat_mode, shuffle, shuffle_seed, context, context_queue, play_order, queue_index, user_queue, history, revision, cue from player_state where id = 1")
    if len(filas) == 0:
        return EstadoCola("", 0, 1.0, "stopped", "off", false, 0, "null", [], [], 0, [], [], 0, 0, false, false)
    return estado_de_fila(filas[0], 0)

# Escalares + cola de usuario + historial (pequeños), SIN la cola de contexto
# ni su orden (vienen vacías): para quien solo toca la cola de usuario o el
# historial. guardar_estado no reescribe las listas de contexto salvo que el
# mutador las asigne (ctx_sucio).
fn EstadoCola leer_estado_medio():
    List<Json> filas = await sqlite.query("select track_id, position_ms, volume, status, repeat_mode, shuffle, shuffle_seed, context, queue_index, user_queue, history, revision, cue from player_state where id = 1")
    if len(filas) == 0:
        return EstadoCola("", 0, 1.0, "stopped", "off", false, 0, "null", [], [], 0, [], [], 0, 0, false, false)
    return estado_de_fila(filas[0], 1)

# Solo los escalares (los ticks de fondo, las fotos, la mayoría de órdenes):
# sin tocar ni parsear las listas. Las listas vienen vacías, y guardar_estado
# lo sabe.
fn EstadoCola leer_estado_ligero():
    List<Json> filas = await sqlite.query("select track_id, position_ms, volume, status, repeat_mode, shuffle, shuffle_seed, context, queue_index, revision, cue from player_state where id = 1")
    if len(filas) == 0:
        return EstadoCola("", 0, 1.0, "stopped", "off", false, 0, "null", [], [], 0, [], [], 0, 0, true, false)
    return estado_de_fila(filas[0], 2)

fn List<Json> user_queue_json(EstadoCola e):
    List<Json> out = []
    for int i in range(0, len(e.user_queue)):
        Dict<string, string> d = { "entryId": e.user_queue[i].entryId, "trackId": e.user_queue[i].trackId }
        out.add(d)
    return out

# Persistencia con cerrojo optimista sobre revision. Devuelve true si ganó.
# Tres formas, de menos a más escritura (el WAL de SQLite crece con cada
# columna reescrita): estado ligero -> solo escalares; completo -> además cola
# de usuario e historial (pequeñas); y la cola de contexto + orden (miles de
# ids) solo si `ctx_sucio`.
fn bool guardar_estado(EstadoCola e):
    int tocado = 0
    if e.ligero:
        tocado = await sqlite.exec(
            """update player_state set track_id = nullif(?, ''), position_ms = ?, volume = ?, status = ?,
               repeat_mode = ?, shuffle = ?, shuffle_seed = ?, context = ?, queue_index = ?, cue = ?,
               revision = revision + 1, updated_at = unixepoch() where id = 1 and revision = ?""",
            e.track_id == "" ? null : e.track_id, e.position_ms, e.volume, e.status, e.repeat_mode,
            e.shuffle ? 1 : 0, e.shuffle_seed, e.context, e.queue_index, e.cue, e.revision)
    elif e.ctx_sucio:
        # (quien lo marca asigna ambas listas enteras, o las leyó completas)
        tocado = await sqlite.exec(
            """update player_state set track_id = nullif(?, ''), position_ms = ?, volume = ?, status = ?,
               repeat_mode = ?, shuffle = ?, shuffle_seed = ?, context = ?, context_queue = ?,
               play_order = ?, queue_index = ?, user_queue = ?, history = ?, cue = ?,
               revision = revision + 1, updated_at = unixepoch() where id = 1 and revision = ?""",
            e.track_id == "" ? null : e.track_id, e.position_ms, e.volume, e.status, e.repeat_mode,
            e.shuffle ? 1 : 0, e.shuffle_seed, e.context, str(e.context_queue),
            str(e.play_order), e.queue_index, str(user_queue_json(e)), str(e.history),
            e.cue, e.revision)
    else:
        tocado = await sqlite.exec(
            """update player_state set track_id = nullif(?, ''), position_ms = ?, volume = ?, status = ?,
               repeat_mode = ?, shuffle = ?, shuffle_seed = ?, context = ?, queue_index = ?,
               user_queue = ?, history = ?, cue = ?,
               revision = revision + 1, updated_at = unixepoch() where id = 1 and revision = ?""",
            e.track_id == "" ? null : e.track_id, e.position_ms, e.volume, e.status, e.repeat_mode,
            e.shuffle ? 1 : 0, e.shuffle_seed, e.context, e.queue_index,
            str(user_queue_json(e)), str(e.history), e.cue, e.revision)
    return tocado == 1

# La ÚNICA forma en que el backend mueve el motor de audio: estrena un cue.
# motor_sincronizar() (motor.lux) aplica cada cue una vez: carga la pista si
# no es la que tiene el motor, o salta a `ms` si lo es.
fn void cuear(EstadoCola e, int ms):
    e.cue = e.cue + 1
    e.position_ms = ms

# Posición real ahora mismo: la del motor de audio si es el que tiene la
# pista (es lo que se oye); si no, la última guardada. En el móvil no hay
# motor: manda lo que el <audio> reportó (movil.lux, `/api/player/media-event`).
fn int posicion_viva(EstadoCola e):
    if e.track_id != "":
        if en_movil():
            if state.get("movil_pista", "") == e.track_id:
                int vivo = int(state.get("movil_pos_ms", "0"))
                if vivo > 0:
                    return vivo
        else:
            Json st = audio.status()
            if jstr(st["trackId"], "") == e.track_id:
                return jint(st["positionMs"], 0)
    return e.position_ms

# Mutación con reintento: recarga, aplica el cambio y compite por la escritura.
# Único punto de la CAS sobre player_state — todo mutador de estado pasa por
# aquí (antes cada llamador copiaba a mano su propio "for intento in range(0,4)").
# argd sólo lo usa "volume" (el único caso que necesita un double); argn hace
# de slot entero genérico (ms, índice, posición de cola...) según la acción.
fn bool mutar_estado(string accion, string arg1, string arg2, int argn, double argd = 0.0):
    # Las acciones que solo tocan escalares no necesitan (ni deben reescribir) las listas.
    bool escalar = accion == "toggle" or accion == "pause" or accion == "resume" or accion == "seek" or accion == "volume" or accion == "repeat"
    bool sin_ctx = accion == "set_track" or accion == "saltar_entry" or accion == "quitar_entry" or accion == "mover_entry" or accion == "clear_user_queue"
    for int intento in range(0, 4):
        EstadoCola e = escalar ? leer_estado_ligero() : (sin_ctx ? leer_estado_medio() : leer_estado())
        bool ok = false
        # Sin cambio real (volumen igual, ya en pausa...) no se escribe ni se sube la revisión.
        string status0 = e.status
        double volume0 = e.volume
        string repeat0 = e.repeat_mode
        if accion == "avanzar":
            ok = cola_avanzar(e, arg1 == "natural")
        elif accion == "retroceder":
            ok = cola_retroceder(e)
        elif accion == "shuffle":
            ok = cola_shuffle(e, arg1 == "1")
        elif accion == "repeat":
            ok = cola_repeat(e, arg1)
        elif accion == "quitar_entry":
            ok = cola_quitar_entry(e, arg1)
        elif accion == "mover_entry":
            ok = cola_mover_entry(e, arg1, argn)
        elif accion == "saltar_entry":
            ok = cola_saltar_entry(e, arg1)
        elif accion == "orden_indice":
            ok = cola_ir_a_indice(e, argn)
        elif accion == "toggle":
            # argn: posición en ms que el motor tenía al pausar (-1 = no la
            # sabe quien pide la pausa -- MPRIS, bandeja --: se usa el ancla)
            if e.track_id != "":
                if e.status == "playing":
                    e.position_ms = argn >= 0 ? argn : posicion_viva(e)
                    e.status = "paused"
                else:
                    e.status = "playing"
                ok = true
        elif accion == "pause":
            if e.status == "playing":
                e.position_ms = argn >= 0 ? argn : posicion_viva(e)
            e.status = "paused"
            ok = true
        elif accion == "resume":
            if e.track_id != "":
                e.status = "playing"
            ok = true
        elif accion == "seek":
            if e.track_id != "":
                cuear(e, argn < 0 ? 0 : argn)
            ok = true
        elif accion == "volume":
            double v = argd
            if v < 0.0:
                v = 0.0
            if v > 1.0:
                v = 1.0
            e.volume = v
            ok = true
        elif accion == "clear_user_queue":
            e.user_queue = []
            ok = true
        elif accion == "set_track":
            if e.track_id != arg1:
                registrar_historial(e)
            e.track_id = arg1
            e.status = "playing"
            cuear(e, 0)
            ok = true
        if not ok:
            return true
        if (accion == "volume" and e.volume == volume0) or (accion == "repeat" and e.repeat_mode == repeat0) or (accion == "pause" and e.status == status0 and argn < 0) or (accion == "resume" and e.status == status0):
            return true
        if guardar_estado(e):
            return true
    return false

# ─── Cola de contexto ────────────────────────────────────────────────────────

# Regenera la cola de contexto (y su orden de reproducción). La cola de
# usuario NO se toca: sobrevive a los cambios de contexto, como en Spotify.
fn bool set_contexto(string context_json, List<string> pistas, string pista_inicial):
    for int intento in range(0, 4):
        EstadoCola e = leer_estado_medio()
        e.context = context_json
        e.context_queue = pistas
        e.ctx_sucio = true
        e.queue_index = 0
        if e.shuffle and len(pistas) > 1:
            e.shuffle_seed = time.now() % 2147483647
            e.play_order = permutacion_estable(len(pistas), e.shuffle_seed)
        else:
            e.play_order = []
        if pista_inicial != "":
            for int i in range(0, len(pistas)):
                if pistas[i] == pista_inicial:
                    e.queue_index = i
                    break
        if guardar_estado(e):
            return true
    return false

# Pista en la posición k del recorrido (permutado o natural).
fn string pista_en_orden(EstadoCola e, int k):
    if k < 0 or k >= len(e.context_queue):
        return ""
    if len(e.play_order) == len(e.context_queue):
        return e.context_queue[e.play_order[k]]
    return e.context_queue[k]

# Ancla la pista actual al inicio del recorrido rotando la permutación:
# "anterior" tiene que funcionar tras reactivar shuffle (el bug documentado
# del original que la rotación corrige).
fn void anclar_actual(EstadoCola e):
    if len(e.play_order) != len(e.context_queue) or len(e.play_order) < 2:
        return
    e.ctx_sucio = true
    int pos = e.play_order[e.queue_index]
    List<int> rotada = []
    for int i in range(0, len(e.play_order)):
        rotada.add(e.play_order[(pos + i) % len(e.play_order)])
    e.play_order = rotada
    e.queue_index = 0

fn void registrar_historial(EstadoCola e):
    if e.track_id == "":
        return
    e.history.add(e.track_id)
    if len(e.history) > 200:
        e.history = e.history.slice(len(e.history) - 200)

# ─── Avance y retroceso ──────────────────────────────────────────────────────

# Avanza de pista. `natural` distingue el fin de la canción del salto manual:
# solo el fin natural repite en modo "track". Sin efectos fuera de `e`: esto
# corre dentro del bucle de reintentos de mutar_estado, y la escucha para
# estadísticas la anota reproductor.lux UNA vez, tras escribir con éxito.
fn bool cola_avanzar(EstadoCola e, bool natural):
    # repetición de pista: solo en fin natural
    if natural and e.repeat_mode == "track" and e.track_id != "":
        cuear(e, 0)
        return true

    registrar_historial(e)

    # 1) la cola de usuario tiene prioridad absoluta
    if len(e.user_queue) > 0:
        e.track_id = e.user_queue[0].trackId
        List<Entrada> resto = []
        for int i in range(1, len(e.user_queue)):
            resto.add(e.user_queue[i])
        e.user_queue = resto
        cuear(e, 0)
        return true

    # 2) avance dentro del contexto
    # Fin sin nada más que sonar: se para, pero la última se QUEDA en el
    # reproductor, al principio (como el original: "se para, no se apaga la
    # sesión"); darle a play la vuelve a poner.
    int n = len(e.context_queue)
    if n == 0:
        cuear(e, 0)
        e.status = "stopped"
        return true
    if e.queue_index + 1 < n:
        e.queue_index = e.queue_index + 1
        e.track_id = pista_en_orden(e, e.queue_index)
        cuear(e, 0)
        return true
    # fin del contexto
    if e.repeat_mode == "queue":
        e.queue_index = 0
        e.track_id = pista_en_orden(e, 0)
        cuear(e, 0)
        return true
    cuear(e, 0)
    e.status = "stopped"
    return true

fn bool cola_retroceder(EstadoCola e):
    # la actual vino de la cola de usuario: tirar del historial
    if len(e.user_queue) == 0 and len(e.history) > 0 and e.context_queue == []:
        e.track_id = e.history[len(e.history) - 1]
        e.history = e.history.slice(0, len(e.history) - 1)
        cuear(e, 0)
        return true
    if e.queue_index > 0 and len(e.context_queue) > 0:
        e.queue_index = e.queue_index - 1
        e.track_id = pista_en_orden(e, e.queue_index)
        cuear(e, 0)
        return true
    if e.track_id != "":
        cuear(e, 0)
        return true
    return false

# ─── Controles ───────────────────────────────────────────────────────────────

fn bool cola_shuffle(EstadoCola e, bool activar):
    if activar == e.shuffle:
        return true
    e.shuffle = activar
    e.ctx_sucio = true
    if activar and len(e.context_queue) > 1:
        e.shuffle_seed = time.now() % 2147483647
        e.play_order = permutacion_estable(len(e.context_queue), e.shuffle_seed)
        anclar_actual(e)
    else:
        # volver al orden natural conservando la pista actual
        string actual = pista_en_orden(e, e.queue_index)
        e.play_order = []
        e.queue_index = 0
        for int i in range(0, len(e.context_queue)):
            if e.context_queue[i] == actual:
                e.queue_index = i
                break
    return true

fn bool cola_repeat(EstadoCola e, string modo):
    if modo == "off" or modo == "queue" or modo == "track":
        e.repeat_mode = modo
        return true
    return false

# ─── Cola de usuario ─────────────────────────────────────────────────────────

fn void cola_annadir_siguientes(List<string> ids):
    for int intento in range(0, 4):
        EstadoCola e = leer_estado_medio()
        # push_front en orden inverso para que A,B suenen A y luego B
        List<Entrada> nueva = []
        for int i in range(0, len(ids)):
            nueva.add(Entrada(nuevo_id(), ids[i]))
        e.user_queue = nueva.concat(e.user_queue)
        if guardar_estado(e):
            return

fn void cola_annadir_al_final(List<string> ids):
    for int intento in range(0, 4):
        EstadoCola e = leer_estado_medio()
        for int i in range(0, len(ids)):
            e.user_queue.add(Entrada(nuevo_id(), ids[i]))
        if guardar_estado(e):
            return

fn bool cola_quitar_entry(EstadoCola e, string entry_id):
    List<Entrada> resto = []
    for int i in range(0, len(e.user_queue)):
        if e.user_queue[i].entryId != entry_id:
            resto.add(e.user_queue[i])
    e.user_queue = resto
    return true

fn bool cola_mover_entry(EstadoCola e, string entry_id, int destino):
    List<Entrada> resto = []
    Entrada? movida = null
    for int i in range(0, len(e.user_queue)):
        if e.user_queue[i].entryId == entry_id:
            movida = e.user_queue[i]
        else:
            resto.add(e.user_queue[i])
    if movida == null:
        return false
    if destino < 0:
        destino = 0
    if destino > len(resto):
        destino = len(resto)
    List<Entrada> nueva = []
    for int i in range(0, len(resto)):
        if i == destino:
            nueva.add(movida)
        nueva.add(resto[i])
    if destino == len(resto):
        nueva.add(movida)
    e.user_queue = nueva
    return true

fn bool cola_saltar_entry(EstadoCola e, string entry_id):
    for int i in range(0, len(e.user_queue)):
        if e.user_queue[i].entryId == entry_id:
            registrar_historial(e)
            e.track_id = e.user_queue[i].trackId
            List<Entrada> resto = []
            for int j in range(0, len(e.user_queue)):
                if j != i:
                    resto.add(e.user_queue[j])
            e.user_queue = resto
            cuear(e, 0)
            return true
    return false

# Saltar a una posición concreta del recorrido del contexto.
fn bool cola_ir_a_indice(EstadoCola e, int indice):
    if indice < 0 or indice >= len(e.context_queue):
        return false
    registrar_historial(e)
    e.queue_index = indice
    e.track_id = pista_en_orden(e, indice)
    cuear(e, 0)
    return true

# Lo que sonaría si la pista actual terminase ahora (fin natural), sin
# tocar nada: el motor de audio lo precarga para el gapless/crossfade.
fn string pista_siguiente_natural(EstadoCola e):
    if e.track_id == "":
        return ""
    if e.repeat_mode == "track":
        return e.track_id
    if len(e.user_queue) > 0:
        return e.user_queue[0].trackId
    int n = len(e.context_queue)
    if e.queue_index + 1 < n:
        return pista_en_orden(e, e.queue_index + 1)
    if e.repeat_mode == "queue" and n > 0:
        return pista_en_orden(e, 0)
    return ""
