# reproductor.lux — Órdenes del reproductor y lo que se publica hacia fuera.
#
# El backend es el único dueño del reproductor (como en el original, donde la
# lógica vivía en Rust y la interfaz solo pintaba y emitía órdenes):
#   - decide QUÉ suena (pista, cola, sonando/pausa, volumen, repetición,
#     aleatorio, historial). Todo cambio pasa por mutar_estado() (queue.lux) y
#     sube `revision`; las pistas nuevas o los saltos estrenan un `cue`.
#   - el motor de audio nativo (audio_engine.cpp, módulo `audio`) toca lo que
#     el estado dice: motor_sincronizar() (motor.lux) aplica cada cue una vez.
#     La posición que ve la interfaz es la del motor, lo que se oye.
#
# Toda orden -- de la interfaz, del menú nativo, de la bandeja, de MPRIS, de la
# tarjeta del escritorio o del propio motor cuando acaba una pista -- entra por
# reproductor_orden(): muta, anota la escucha, mueve el motor y publica en
# MPRIS/Discord.

# ─── Estado para la interfaz ─────────────────────────────────────────────────

# PlayerStateDto + revision y cue, que es lo que el cliente necesita para
# ordenar y aplicar. positionMs es la posición VIVA (ancla), no la última
# guardada.
fn Json estado_dto():
    EstadoCola e = leer_estado()
    Json? pista = track_row_por_id(e.track_id)
    int duracion = pista == null ? 0 : jint(pista["durationMs"], 0)
    int pos = posicion_viva(e)
    if duracion > 0 and pos > duracion:
        pos = duracion
    Json? ctx = parse_json(e.context)
    return {
        "track": pista,
        "status": e.status,
        "positionMs": pos,
        "durationMs": duracion,
        "bufferedMs": pista != null and e.status == "playing" ? duracion : 0,
        "volume": e.volume,
        "repeat": e.repeat_mode,
        "shuffle": e.shuffle,
        "context": ctx,
        "revision": e.revision,
        "cue": e.cue
    }

# ─── Escuchas (estadísticas) ─────────────────────────────────────────────────

# Una escucha cuenta a partir de 5 s y es "completa" desde el 90 %, como en
# el original. Se escribe EN CURSO, no al acabar: la fila nace al llegar a
# los 5 s y se va actualizando con cada informe del motor (cada ~5 s), cada
# orden y al cerrarse (cambio de pista, fin natural), así que las
# estadísticas se mueven mientras suena. El tiempo es el que de verdad sonó,
# sin pausas, medido por el motor.
#
# La escucha abierta vive en `state` (memoria del proceso): su fila, su
# pista, lo último sabido y cuándo, para estimar lo que sonó desde entonces
# cuando la orden viene de fuera (MPRIS, bandeja) y nadie trae la cifra.

fn void escucha_progreso(string track_id, int ms, string contexto):
    if track_id == "" or ms < 5000:
        return
    List<Json> f = await sqlite.query("select duration_ms from tracks where id = ?", track_id)
    int dur = len(f) > 0 ? jint(f[0]["duration_ms"], 0) : 0
    int completa = dur > 0 and ms * 10 >= dur * 9 ? 1 : 0
    string id = state.get("escucha_id", "")
    if id != "" and state.get("escucha_pista", "") == track_id:
        await sqlite.exec("update play_history set ms_played = max(ms_played, ?), completed = max(completed, ?) where id = ?",
            ms, completa, id)
    else:
        id = nuevo_id()
        await sqlite.exec("insert into play_history(id, track_id, played_at, ms_played, completed, context) values(?, ?, unixepoch(), ?, ?, ?)",
            id, track_id, ms, completa, contexto)
        state.set("escucha_id", id)
        state.set("escucha_pista", track_id)
    state.set("escucha_ms", str(ms))
    state.set("escucha_t", str(time.now()))
    marcar_estadisticas()

fn void escucha_cerrar():
    state.remove("escucha_id")
    state.remove("escucha_pista")
    state.remove("escucha_ms")
    state.remove("escucha_t")

# Lo escuchado de `e.track_id` hasta ahora: lo que el motor lleva sonado de
# verdad (sin pausas ni saltos). Si el motor no tiene esa pista (todavía no se
# cargó, o se descargaba), la posición.
fn int escucha_estimada(EstadoCola e):
    if e.track_id != "":
        Json st = audio.status()
        if jstr(st["trackId"], "") == e.track_id:
            return jint(st["listenedMs"], 0)
    return posicion_viva(e)

# La interfaz repinta las estadísticas cuando cambia este sello (events.lux).
fn void marcar_estadisticas():
    state.set("stamp_stats", str(time.now()))

# ─── La puerta única ─────────────────────────────────────────────────────────

fn Json reproductor_orden(string orden, Json args):
    EstadoCola antes = leer_estado()
    if orden == "position":
        # Consulta barata (la vista de "ahora suena" la pide a 4 Hz): no muta nada.
        int dur = jint(jget(audio.status(), "durationMs"), 0)
        int pos = posicion_viva(antes)
        return { "positionMs": pos, "bufferedMs": dur > 0 ? dur : pos }
    # Lo escuchado hasta ahora. Un aviso del motor (handoff/ended) trae el
    # suyo: para entonces el motor ya cambió de pista.
    int escuchado = jint(jget(args, "__listenedMs"), -1)
    if escuchado < 0:
        escuchado = escucha_estimada(antes)
    bool natural = false

    if orden == "play_track":
        string track_id = arg_str(args, "trackId", "")
        if track_id == "":
            return error_api("INVALID", "error.invalid").status(400)
        garantizar_biblioteca()
        Json ctx = contexto_desde_args(args, track_id)
        set_contexto(str(ctx), pistas_de_contexto_dto(ctx, track_id), track_id)
        mutar_estado("set_track", track_id, "", 0)
    elif orden == "toggle":
        mutar_estado("toggle", "", "", -1)
    elif orden == "pause":
        mutar_estado("pause", "", "", -1)
    elif orden == "resume":
        mutar_estado("resume", "", "", 0)
    elif orden == "next":
        mutar_estado("avanzar", "skip", "", 0)
    elif orden == "ended":
        # Fin natural, con el cue en el que estaba el motor. Un aviso de un
        # cue que ya no es el vigente (dos avisos del mismo final, o uno que
        # llega después de que el usuario cambiara de canción) no avanza nada:
        # antes cada uno avanzaba la cola una vez más.
        if jint(jget(args, "cue"), -1) != antes.cue:
            return estado_dto()
        natural = true
        mutar_estado("avanzar", "natural", "", 0)
    elif orden == "previous":
        # Regla de los 3 s de Spotify: por encima, reinicia la actual.
        if posicion_viva(antes) > 3000:
            mutar_estado("seek", "", "", 0)
        else:
            mutar_estado("retroceder", "", "", 0)
    elif orden == "seek":
        mutar_estado("seek", "", "", jint(jget(args, "positionMs"), 0))
    elif orden == "set_volume":
        mutar_estado("volume", "", "", 0, jdbl(jget(args, "volume"), 1.0))
    elif orden == "set_repeat":
        mutar_estado("repeat", arg_str(args, "mode", "off"), "", 0)
    elif orden == "set_shuffle":
        mutar_estado("shuffle", jget(args, "enabled") == true ? "1" : "0", "", 0)
    elif orden == "jump_to":
        mutar_estado("saltar_entry", arg_str(args, "entryId", ""), "", 0)
    else:
        return error_api("INVALID", "error.invalid").status(400)

    EstadoCola despues = leer_estado()
    bool cambio_pista = despues.track_id != antes.track_id
    if antes.track_id != "" and (cambio_pista or (natural and despues.cue != antes.cue)):
        escucha_progreso(antes.track_id, escuchado, antes.context)
        escucha_cerrar()
    else:
        escucha_progreso(antes.track_id, escuchado, antes.context)
    if cambio_pista and despues.track_id != "":
        asegurar_descarga(despues.track_id, "immediate")
    # Cuando el motor ya está tocando la pista a la que la cola acaba de
    # avanzar (relevo gapless/crossfade), se adopta tal cual: ni recargar ni
    # saltar. Si la cola no coincide con lo que el motor eligió (cambió entre
    # medias), motor_sincronizar carga la que toca.
    string entra = jstr(jget(args, "__entra"), "")
    if orden == "ended" and entra != "" and despues.track_id == entra:
        state.set("motor_clave", str(despues.cue) + ":" + despues.track_id)
    motor_sincronizar(despues)
    if despues.revision != antes.revision:
        publicar_integraciones()
    return estado_dto()

# ─── Hacia fuera ─────────────────────────────────────────────────────────────

# URL PÚBLICA de la carátula: la del álbum (i.scdn.co, lh3.googleusercontent),
# o la miniatura del vídeo si no hay álbum con portada. Tiene que ser pública:
# quien la descarga es el cliente de Discord, en su propio proceso, donde ni
# una ruta local ni el puerto de esta app significan nada. Se cachea por
# pista: esto corre en cada publicación.
fn string portada_publica(string track_id):
    string k = "portada_pub:" + track_id
    string c = state.get(k, "")
    if c != "":
        return c == "-" ? "" : c
    string url = ""
    List<Json> f = await sqlite.query("select al.cover_url as u from tracks t join albums al on al.id = t.album_id where t.id = ?", track_id)
    if len(f) > 0:
        url = jstr(f[0]["u"], "")
    if url == "":
        string yid = youtube_id_de_pista(track_id)
        if yid != "":
            url = url_miniatura_video(yid).replace("/maxresdefault.jpg", "/hq720.jpg")   # sin 404 posible de fallback: va a Discord/MPRIS tal cual
    state.set(k, url == "" ? "-" : url)
    return url

# MPRIS y Discord a partir del estado actual. Se llama tras cada orden y en
# cada sondeo: Discord solo acepta unos pocos cambios por minuto, y lo que no
# pudo salir en su momento sale en una llamada posterior (discord_rpc.cpp
# guarda siempre el último estado deseado, no los intermedios).
fn void publicar_integraciones():
    EstadoCola e = leer_estado()
    Json? pista = track_row_por_id(e.track_id)
    int dur = pista == null ? 0 : jint(pista["durationMs"], 0)
    int pos = posicion_viva(e)
    if dur > 0 and pos > dur:
        pos = dur
    string titulo = pista == null ? "" : jstr(pista["title"], "")
    string artista = pista == null ? "" : jstr(pista["artistDisplay"], "")
    string album = pista == null ? "" : jstr(pista["albumTitle"], "")
    string portada = pista == null ? "" : portada_publica(e.track_id)

    window.mpris_update({
        "trackId": e.track_id,
        "title": titulo,
        "artist": artista,
        "album": album,
        "artUrl": portada,
        "durationMs": dur,
        "positionMs": pos,
        "status": e.status,
        "volume": e.volume,
        "shuffle": e.shuffle,
        "repeat": e.repeat_mode,
        "cue": e.cue,
        "revision": e.revision
    })

    Json integraciones = jget(ajustes_estructurados(), "integrations")
    bool discord_on = integraciones != null and jget(integraciones, "discordEnabled") == true
    string discord_id = discord_on ? jstr(jget(integraciones, "discordClientId"), "").trim() : ""
    # Pausado o parado no se anuncia (el original tampoco): un perfil que
    # dice "escuchando" algo en pausa desde hace media hora es peor que uno
    # vacío. Inicio y FIN, para que Discord pinte la barra de progreso.
    Json? actividad = null
    if pista != null and e.status == "playing":
        int inicio = int((time.now() - pos) / 1000)
        actividad = {
            "title": titulo,
            "artist": artista,
            "album": album,
            "coverUrl": portada,
            "startS": inicio,
            "endS": dur > 0 ? inicio + int(dur / 1000) : 0
        }
    window.discord_update({ "clientId": discord_id, "activity": actividad, "revision": e.revision })
