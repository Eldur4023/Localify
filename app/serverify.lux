# serverify.lux — Cliente del servidor común opcional (ver server/server.lux).
#
# Localify sigue siendo local y offline al 100%: todo lo de aquí es un
# atajo OPCIONAL. Si no hay servidor configurado, si no hay sesión o si no
# responde, cada función devuelve "nada" y el flujo de siempre (YouTube
# Music + yt-dlp) sigue exactamente igual. Las descargas las hace siempre este
# cliente: del servidor si ya tiene la canción, de yt-dlp si no.
#
# Ajustes (tabla settings): server_host, server_port, server_token,
# server_user, server_upload ("1" = aportar al servidor lo que descargo).

# ─── Conexión ────────────────────────────────────────────────────────────────

fn string srv_base():
    return "http://" + ajuste("server_host", "") + ":" + ajuste("server_port", "8787") + "/api"

# Hay servidor configurado y sesión iniciada
fn bool srv_sesion():
    return ajuste("server_host", "") != "" and ajuste("server_token", "") != ""

# Disponible para los atajos: sesión y sin fallo reciente (un servidor caído no
# debe costar el timeout en cada búsqueda)
fn bool srv_activo():
    return srv_sesion() and state.get("srv_caido", "") == ""

# Petición con el token. Devuelve { status, body } o null si no hay conexión.
# Un 401 borra el token (caducado o usuario borrado): la UI vuelve a pedir login.
fn Json? srv(string metodo, string ruta, Json cuerpo = null, int timeout_ms = 4000):
    Dict<string, string> cab = { "Authorization": "Bearer " + ajuste("server_token", "") }
    Json r = null
    try:
        string url = srv_base() + ruta
        Dict<string, Json> op = { "timeout_ms": timeout_ms }
        if metodo == "GET":
            r = await http.get(url, cab, op)
        elif metodo == "POST":
            r = await http.post(url, cuerpo == null ? {} : cuerpo, cab, op)
        elif metodo == "PUT":
            r = await http.put(url, cuerpo == null ? {} : cuerpo, cab, op)
        else:
            r = await http.delete(url, cab, op)
    catch e:
        state.set("srv_caido", "1", 30000)
        return null
    if jint(r["status"], 0) == 401:
        ajuste_poner("server_token", "")
    return { "status": jint(r["status"], 0), "body": r["body"] }

# ─── Atajos de descarga y búsqueda ───────────────────────────────────────────

fn PistaCatalogo srv_pista(Json it):
    PistaCatalogo p = PistaCatalogo()
    p.id = jstr(it["id"], "")
    p.title = jstr(it["title"], "")
    p.duration_ms = jint(it["durationMs"], 0)
    if p.duration_ms <= 0:
        p.duration_ms = 1
    string artista = jstr(it["artist"], "")
    if artista != "":
        p.artista_ids = ["srv:" + normalizar(artista)]
        p.artista_nombres = [artista]
    string album = jstr(it["album"], "")
    if album != "":
        p.album_id = "srv:" + normalizar(album)
        p.album_titulo = album
    return p

# Pistas que el servidor tiene para una consulta (lista vacía si no hay).
fn List<Json> srv_buscar(string q, int limite = 20):
    if not srv_activo() or normalizar(q) == "":
        return []
    Json? r = srv("GET", "/tracks/search?limit=" + str(limite) + "&q=" + http.url_encode(normalizar(q)))
    if r == null or r["status"] != 200:
        return []
    return jlist(r["body"])

# Búsqueda del usuario: las coincidencias del servidor se guardan como pistas
# del catálogo local (igual que las de YouTube Music), así que el resto de la
# búsqueda las encuentra sin saber de dónde vienen. No pisa las que ya existen.
fn void srv_traer_coincidencias(string q):
    List<Json> items = srv_buscar(q)
    for int i in range(0, len(items)):
        PistaCatalogo p = srv_pista(items[i])
        if p.id == "" or p.title == "":
            continue
        List<Json> ya = await sqlite.query("select 1 from tracks where id = ?", p.id)
        if len(ya) == 0 and equivalente_local(normalizar(p.title), normalizar(jstr(items[i]["artist"], "")), jint(items[i]["durationMs"], 0), "", false) == "":
            guardar_pista(p)

# Id de la pista en el servidor: la identidad (título + artista normalizados +
# duración) manda, no el id; "" si el servidor no la tiene.
fn string srv_id_de(string tid):
    List<Json> f = await sqlite.query("select title_norm, artist_norm, duration_ms from tracks where id = ?", tid)
    if len(f) == 0:
        return ""
    Json? r = srv("POST", "/tracks/match", { "items": [{
        "id": tid, "titleNorm": jstr(f[0]["title_norm"], ""), "artistNorm": jstr(f[0]["artist_norm"], ""),
        "durationMs": jint(f[0]["duration_ms"], 0) }] })
    if r == null or r["status"] != 200 or len(jlist(r["body"])) == 0:
        return ""
    return jstr(r["body"][0]["serverId"], "")

# Descarga la pista del servidor al temporal del trabajo y lo deja en
# 'finalizing'. false = el servidor no la tiene (o no hay servidor): seguir con
# yt-dlp. El trabajo ya está en 'downloading' con dlh="srv" (ver promover_cola).
fn bool srv_obtener(string tid):
    if not srv_activo():
        return false
    string sid = srv_id_de(tid)
    if sid == "":
        return false
    garantizar_biblioteca()
    string destino = os.path_join(biblioteca_raiz(), ".tmp", tid + ".webm")
    Dict<string, string> cab = { "Authorization": "Bearer " + ajuste("server_token", "") }
    try:
        Json r = await http.get(srv_base() + "/tracks/" + sid + "/audio", cab, { "save_to": destino, "timeout_ms": 120000 })
        if jint(r["status"], 0) != 200 or os.file_size(destino) < 16384:
            os.remove_file(destino)
            return false
    catch e:
        os.remove_file(destino)
        return false
    state.set("srvdl:" + tid, "1")
    await sqlite.exec("update download_jobs set tmp_path = ?, state = 'finalizing', updated_at = unixepoch() where track_id = ?", destino, tid)
    return true

# Sube un fichero de audio al servidor. true si lo guardó (o ya lo tenía).
fn bool srv_poner(string tid, string ruta, string ext, string titulo, string artista, string album, int duracion_ms):
    Dict<string, string> cab = { "Authorization": "Bearer " + ajuste("server_token", "") }
    try:
        Json r = await http.put(srv_base() + "/tracks/" + tid, {
            "title": titulo, "artist": artista, "album": album, "ext": ext,
            "duration_ms": str(duracion_ms),
            "search_norm": normalizar(titulo + " " + artista + " " + album),
            "title_norm": normalizar(titulo), "artist_norm": normalizar(artista)
        }, cab, { "files": { "audio": ruta }, "timeout_ms": 120000 })
        return jint(r["status"], 0) < 300
    catch e:
        state.set("srv_caido", "1", 30000)
        return false

# Aporta al servidor una pista que acabo de descargar de YouTube. Nunca falla
# la descarga por esto. No sube lo que vino del propio servidor, ni lo que el
# servidor ya tiene (aunque sea con otro id: la identidad es título + artista).
fn void srv_subir(string tid, string ruta, string ext, string titulo, string artista, string album, int duracion_ms):
    if state.get("srvdl:" + tid, "") != "":
        state.remove("srvdl:" + tid)
        return
    if not srv_activo() or ajuste("server_upload", "1") != "1":
        return
    if srv_id_de(tid) != "":
        return
    srv_poner(tid, ruta, ext, titulo, artista, album, duracion_ms)

# ─── Mi biblioteca en el servidor (la "nube") ────────────────────────────────

# Da de alta (o actualiza el favorito de) una pista mía en mi biblioteca del
# servidor. Solo cuenta si el servidor tiene el audio; si no, no hace nada.
fn void srv_alta(string tid):
    if not srv_activo():
        return
    List<Json> f = await sqlite.query("""
        select title_norm, artist_norm, duration_ms,
               (select count(*) from favorites fv where fv.track_id = tracks.id) as fav
        from tracks where id = ?""", tid)
    if len(f) == 0:
        return
    srv("PUT", "/library", { "items": [{ "id": tid, "titleNorm": jstr(f[0]["title_norm"], ""),
        "artistNorm": jstr(f[0]["artist_norm"], ""), "durationMs": jint(f[0]["duration_ms"], 0),
        "favorite": jint(f[0]["fav"], 0) > 0 }] })

# Favorito marcado/desmarcado aquí: se refleja en la nube (si existe sesión).
fn void srv_favorito(string tid, bool activo):
    if not srv_activo():
        return
    if activo:
        srv_alta(tid)
        return
    List<Json> f = await sqlite.query("select title_norm, artist_norm, duration_ms from tracks where id = ?", tid)
    if len(f) > 0:
        srv("PUT", "/library/favorite", { "id": tid, "titleNorm": jstr(f[0]["title_norm"], ""),
            "artistNorm": jstr(f[0]["artist_norm"], ""), "durationMs": jint(f[0]["duration_ms"], 0), "favorite": false })

# Quitar una pista de mi biblioteca también la quita de la nube (el audio compartido se queda).
fn void srv_baja(string tid):
    if not srv_activo():
        return
    List<Json> f = await sqlite.query("select title_norm, artist_norm, duration_ms from tracks where id = ?", tid)
    if len(f) > 0:
        srv("POST", "/library/remove", { "id": tid, "titleNorm": jstr(f[0]["title_norm"], ""),
            "artistNorm": jstr(f[0]["artist_norm"], ""), "durationMs": jint(f[0]["duration_ms"], 0) })

# ─── Playlists locales <-> servidor ──────────────────────────────────────────

fn List<Json> pistas_locales_de(string plid):
    List<Json> f = await sqlite.query("""
        select t.id, t.title, t.artist_display as artist, coalesce(al.title, '') as album, t.duration_ms as durationMs,
               t.title_norm as titleNorm, t.artist_norm as artistNorm
        from playlist_items pi join tracks t on t.id = pi.track_id
        left join albums al on al.id = t.album_id
        where pi.playlist_id = ? order by pi.position""", plid)
    return f

# Añade a la playlist local la pista de una referencia del servidor, reutilizando
# la que ya tengo si es la misma canción (por id o por identidad) en vez de crear otra.
fn void anadir_local(string plid, Json it):
    PistaCatalogo p = srv_pista(it)
    string tid = p.id
    List<Json> ya = await sqlite.query("select 1 from tracks where id = ?", tid)
    if len(ya) == 0:
        string igual = equivalente_local(normalizar(p.title), normalizar(jstr(it["artist"], "")), jint(it["durationMs"], 0), "", false)
        if igual != "":
            tid = igual
        else:
            guardar_pista(p)
    List<Json> ahi = await sqlite.query("select 1 from playlist_items where playlist_id = ? and track_id = ?", plid, tid)
    if len(ahi) > 0:
        return
    List<Json> m = await sqlite.query("select coalesce(max(position), 0) as p from playlist_items where playlist_id = ?", plid)
    await sqlite.exec("insert into playlist_items(id, playlist_id, track_id, position, added_at) values(?, ?, ?, ?, unixepoch())",
        nuevo_id(), plid, tid, jdbl(m[0]["p"], 0.0) + 1.0)

# Clave de identidad de una referencia del servidor o de una pista local
fn string clave_ref(Json it):
    string tn = jstr(it["titleNorm"], "")
    if tn == "":
        tn = normalizar(jstr(it["title"], ""))
    string an = jstr(it["artistNorm"], "")
    if an == "":
        an = normalizar(jstr(it["artist"], ""))
    return tn + "|" + an

# id local de la playlist enlazada a una del servidor ("" si no hay)
fn string local_de(string sid):
    List<Json> f = await sqlite.query("select key from settings where key like 'srvpl:%' and value = ?", sid)
    if len(f) == 0:
        return ""
    return jstr(f[0]["key"], "").slice(6)

fn Json srv_fallo(Json? r):
    if r == null:
        return error_api("SERVER_UNREACHABLE", "error.server_unreachable").status(502)
    if r["status"] == 401:
        return error_api("SERVER_AUTH", "error.server_auth").status(401)
    return error_api("SERVER_ERROR", "error.server_error").status(jint(r["status"], 500))

# ─── Playlists: el servidor las gestiona ─────────────────────────────────────
#
# Todas mis playlists locales se reflejan en el servidor (privadas por defecto) y
# los cambios viajan en los dos sentidos (altas, nombres, canciones, orden y
# borrados). Cada playlist enlazada guarda en `settings` la última versión
# sincronizada (srvph = canciones, srvpm = nombre+descripción, srvpu = updatedAt del
# servidor), así se sabe quién cambió desde entonces:
#   solo yo -> empujo · solo el servidor -> traigo · los dos -> unión sin perder nada.
# srv_reconciliar() lo hace con todas; corre cada ~30 s desde el sondeo de eventos y
# enseguida tras cualquier cambio en una playlist (ver despachar).

fn string hash_claves(List<Json> pistas):
    List<string> vistas = []
    for int i in range(0, len(pistas)):
        string k = clave_ref(pistas[i])
        if not vistas.contains(k):
            vistas.add(k)
    return hash.sha256(vistas.join("\n"))

fn string meta_local(string plid):
    List<Json> f = await sqlite.query("select name, coalesce(description, '') as d from playlists where id = ?", plid)
    if len(f) == 0:
        return ""
    return jstr(f[0]["name"], "") + "\n" + jstr(f[0]["d"], "")

fn Json refs_de(List<Json> pistas):
    List<Json> out = []
    for int i in range(0, len(pistas)):
        out.add({ "id": pistas[i]["id"], "title": pistas[i]["title"], "artist": pistas[i]["artist"],
                  "album": pistas[i]["album"], "durationMs": pistas[i]["durationMs"],
                  "titleNorm": pistas[i]["titleNorm"], "artistNorm": pistas[i]["artistNorm"] })
    return out

fn void marcar_sincronizada(string plid, string sid, int actualizada):
    ajuste_poner("srvph:" + plid, hash_claves(pistas_locales_de(plid)))
    ajuste_poner("srvpm:" + plid, meta_local(plid))
    ajuste_poner("srvpu:" + plid, str(actualizada))

# Otro usuario u otro servidor en este equipo: los enlaces con la nube anterior no valen.
fn void olvidar_enlaces():
    await sqlite.exec("delete from settings where key like 'srvp%'")

fn void olvidar_playlist(string plid):
    await sqlite.exec("delete from settings where key in (?, ?, ?, ?)", "srvpl:" + plid, "srvph:" + plid, "srvpm:" + plid, "srvpu:" + plid)

# Sustituye las canciones y el nombre de la playlist local por los del servidor.
fn void traer_a_local(string plid, Json pl):
    await sqlite.exec("delete from playlist_items where playlist_id = ?", plid)
    List<Json> remotas = jlist(pl["tracks"])
    for int i in range(0, len(remotas)):
        anadir_local(plid, remotas[i])
    string nombre = jstr(pl["name"], "")
    if nombre != "":
        await sqlite.exec("update playlists set name = ?, name_norm = ?, description = ?, updated_at = unixepoch() where id = ?",
            nombre, normalizar(nombre), jstr(pl["description"], ""), plid)
    tocar_playlists()

# Crea en el servidor una copia de una playlist local y la enlaza. Devuelve su id ("" si falla).
fn string crear_en_servidor(string plid, string visibilidad = "private", bool colaborativa = false):
    List<Json> f = await sqlite.query("select name, coalesce(description, '') as d from playlists where id = ?", plid)
    if len(f) == 0:
        return ""
    Json? r = srv("POST", "/playlists", { "name": jstr(f[0]["name"], ""), "description": jstr(f[0]["d"], ""),
        "visibility": visibilidad, "collaborative": colaborativa, "tracks": refs_de(pistas_locales_de(plid)) }, 15000)
    if r == null or r["status"] != 201:
        return ""
    string sid = str(r["body"]["id"])
    ajuste_poner("srvpl:" + plid, sid)
    marcar_sincronizada(plid, sid, 0)
    return sid

# Sincroniza una playlist local con su par del servidor (ver la regla arriba).
fn Json sync_una(string plid, string sid):
    Json? r = srv("GET", "/playlists/" + sid, null, 10000)
    if r == null or r["status"] != 200:
        return srv_fallo(r)
    Json pl = r["body"]
    List<Json> remotas = jlist(pl["tracks"])
    List<Json> locales = pistas_locales_de(plid)
    string lh = hash_claves(locales)
    string sh = hash_claves(remotas)
    string ml = meta_local(plid)
    string ms = jstr(pl["name"], "") + "\n" + jstr(pl["description"], "")
    string ultimo_h = ajuste("srvph:" + plid, "")
    string ultimo_m = ajuste("srvpm:" + plid, "")
    int actualizada = jint(pl["updatedAt"], 0)
    if lh == sh and ml == ms:
        marcar_sincronizada(plid, sid, actualizada)
        return { "localId": plid, "serverId": sid }
    bool local_cambio = lh != ultimo_h or ml != ultimo_m
    bool server_cambio = sh != ultimo_h or ms != ultimo_m
    bool puede_pistas = pl["access"] == "owner" or pl["access"] == "member"
    bool puede_meta = pl["access"] == "owner"
    if local_cambio and not server_cambio and puede_pistas:
        # empujo mis cambios
        Dict<string, Json> cuerpo = { "tracks": refs_de(locales) }
        if puede_meta:
            List<Json> d = await sqlite.query("select name, coalesce(description, '') as d from playlists where id = ?", plid)
            cuerpo["name"] = jstr(d[0]["name"], "")
            cuerpo["description"] = jstr(d[0]["d"], "")
            cuerpo["visibility"] = jstr(pl["visibility"], "private")
            cuerpo["collaborative"] = pl["collaborative"] == true
        Json? p = srv("PUT", "/playlists/" + sid, cuerpo, 15000)
        if p == null or p["status"] >= 300:
            return srv_fallo(p)
    elif local_cambio and server_cambio and puede_pistas:
        # cambiaron los dos: unión (lo mío primero, luego lo que solo tiene el servidor)
        List<string> mias = []
        for int i in range(0, len(locales)):
            mias.add(clave_ref(locales[i]))
        List<Json> union = refs_de(locales)
        for int i in range(0, len(remotas)):
            if not mias.contains(clave_ref(remotas[i])):
                union.add(remotas[i])
        Dict<string, Json> cuerpo = { "tracks": union }
        if puede_meta:
            cuerpo["name"] = jstr(pl["name"], "")
            cuerpo["description"] = jstr(pl["description"], "")
            cuerpo["visibility"] = jstr(pl["visibility"], "private")
            cuerpo["collaborative"] = pl["collaborative"] == true
        Json? p = srv("PUT", "/playlists/" + sid, cuerpo, 15000)
        if p == null or p["status"] >= 300:
            return srv_fallo(p)
        Json fusion = { "tracks": union, "name": jstr(pl["name"], ""), "description": jstr(pl["description"], "") }
        traer_a_local(plid, fusion)
    else:
        # cambió el servidor (u otra persona, o yo sin permiso): manda el servidor
        traer_a_local(plid, pl)
    Json? nuevo = srv("GET", "/playlists/" + sid, null, 10000)
    marcar_sincronizada(plid, sid, nuevo != null and nuevo["status"] == 200 ? jint(nuevo["body"]["updatedAt"], 0) : actualizada)
    tocar_playlists()
    return { "localId": plid, "serverId": sid }

# Crea (si hace falta) la playlist local enlazada a una del servidor y las sincroniza.
fn Json importar_playlist(string sid):
    Json? r = srv("GET", "/playlists/" + sid, null, 10000)
    if r == null or r["status"] != 200:
        return srv_fallo(r)
    string plid = local_de(sid)
    if plid == "":
        plid = nuevo_id()
        string nombre = jstr(r["body"]["name"], "")
        List<Json> f = await sqlite.query("select coalesce(max(position), 0) as p from playlists")
        await sqlite.exec("insert into playlists(id, name, name_norm, position, created_at, updated_at) values(?, ?, ?, ?, unixepoch(), unixepoch())",
            plid, nombre, normalizar(nombre), jdbl(f[0]["p"], 0.0) + 1.0)
        ajuste_poner("srvpl:" + plid, sid)
        # vacía y sin cambios míos: la primera sincronización trae lo del servidor
        ajuste_poner("srvph:" + plid, hash_claves([]))
        ajuste_poner("srvpm:" + plid, meta_local(plid))
    return sync_una(plid, sid)

# Pasa por todas mis playlists. Barato cuando no hay cambios (sin peticiones por playlist).
fn void srv_reconciliar():
    if not srv_activo():
        return
    string yo = ajuste("server_user", "")
    Json? tl = srv("GET", "/playlist-tombstones")
    Json? ps = srv("GET", "/playlists")
    if tl == null or ps == null or tl["status"] != 200 or ps["status"] != 200:
        return
    List<Json> borradas = jlist(tl["body"])
    Dict<string, Json> remotas = {}
    List<Json> lista = jlist(ps["body"])
    for int i in range(0, len(lista)):
        remotas[str(lista[i]["id"])] = lista[i]
    # 1) mis playlists locales
    List<Json> locales = await sqlite.query("select id, name from playlists")
    List<string> enlazadas = []
    for int i in range(0, len(locales)):
        string plid = jstr(locales[i]["id"], "")
        string sid = ajuste("srvpl:" + plid, "")
        if sid == "":
            # ¿ya hay una mía con el mismo nombre sin enlazar (de otro equipo)? se enlaza, no se duplica
            for int j in range(0, len(lista)):
                if sid == "" and jstr(lista[j]["owner"], "") == yo and local_de(str(lista[j]["id"])) == "" and normalizar(jstr(lista[j]["name"], "")) == normalizar(jstr(locales[i]["name"], "")) and not enlazadas.contains(str(lista[j]["id"])):
                    sid = str(lista[j]["id"])
                    ajuste_poner("srvpl:" + plid, sid)
            if sid == "":
                sid = crear_en_servidor(plid)
                if sid == "":
                    continue
                enlazadas.add(sid)
                continue
            enlazadas.add(sid)
            sync_una(plid, sid)
            continue
        enlazadas.add(sid)
        if borradas.contains(int(sid)):
            # borrada en otro equipo (o por su dueña): se borra aquí también
            await sqlite.exec("delete from playlists where id = ?", plid)
            olvidar_playlist(plid)
            tocar_playlists()
            continue
        if remotas[sid] == null:
            # el servidor la perdió sin haberla borrado nadie: se vuelve a subir
            ajuste_poner("srvpl:" + plid, "")
            string nuevo = crear_en_servidor(plid)
            if nuevo == "":
                olvidar_playlist(plid)
            continue
        # ¿algo cambió? (yo: canciones o nombre; el servidor: updatedAt)
        bool cambio = hash_claves(pistas_locales_de(plid)) != ajuste("srvph:" + plid, "") or meta_local(plid) != ajuste("srvpm:" + plid, "") or str(jint(remotas[sid]["updatedAt"], 0)) != ajuste("srvpu:" + plid, "")
        if cambio:
            sync_una(plid, sid)
    # 2) enlaces cuya playlist local ya no existe: se borró aquí -> fuera del servidor
    List<Json> enlaces = await sqlite.query("select key, value from settings where key like 'srvpl:%'")
    for int i in range(0, len(enlaces)):
        string plid = jstr(enlaces[i]["key"], "").slice(6)
        List<Json> existe = await sqlite.query("select 1 from playlists where id = ?", plid)
        if len(existe) == 0:
            string sid = jstr(enlaces[i]["value"], "")
            if remotas[sid] != null:
                if jstr(remotas[sid]["owner"], "") == yo:
                    srv("DELETE", "/playlists/" + sid)
                else:
                    srv("DELETE", "/playlists/" + sid + "/members/" + http.url_encode(yo))
            olvidar_playlist(plid)
    # 3) las mías y las conjuntas a las que me invitaron que este equipo aún no tiene: se traen.
    # (La lista del servidor solo trae las mías y aquellas en las que soy miembro.) Si no
    # la quiero, la borro aquí y con eso salgo de ella.
    for int i in range(0, len(lista)):
        string sid = str(lista[i]["id"])
        if not enlazadas.contains(sid) and not borradas.contains(int(sid)) and local_de(sid) == "":
            importar_playlist(sid)

# ─── Comandos (server_* ajustes/sesión, social_* usuarios y playlists) ───────

fn Json sesion_guardada(Json? r):
    if r == null or (r["status"] != 200 and r["status"] != 201):
        if r != null and r["status"] == 409:
            return error_api("USERNAME_TAKEN", "error.username_taken").status(409)
        if r != null and (r["status"] == 401 or r["status"] == 400 or r["status"] == 429):
            return error_api("SERVER_AUTH", "error.server_auth_" + str(r["status"])).status(r["status"])
        return srv_fallo(r)
    # server_cuenta sobrevive al cierre de sesión: volver a entrar con el mismo usuario conserva
    # los enlaces; entrar con otro (u otro servidor) los descarta
    if ajuste("server_cuenta", "") != jstr(r["body"]["user"]["username"], ""):
        olvidar_enlaces()
    ajuste_poner("server_cuenta", jstr(r["body"]["user"]["username"], ""))
    ajuste_poner("server_token", jstr(r["body"]["token"], ""))
    ajuste_poner("server_user", jstr(r["body"]["user"]["username"], ""))
    state.remove("srv_caido")
    return r["body"]["user"]

fn Json cmd_social(string cmd, Json args):
    if cmd == "server_status":
        bool alcanzable = false
        if ajuste("server_host", "") != "":
            try:
                Json i = await http.get(srv_base() + "/info", null, { "timeout_ms": 3000 })
                alcanzable = jint(i["status"], 0) == 200
            catch e:
                alcanzable = false
        if alcanzable:
            state.remove("srv_caido")
        return {
            "host": ajuste("server_host", ""), "port": int(ajuste("server_port", "8787")),
            "reachable": alcanzable, "loggedIn": ajuste("server_token", "") != "",
            "username": ajuste("server_user", ""), "upload": ajuste("server_upload", "1") == "1"
        }
    if cmd == "server_connect":
        string host = arg_str(args, "host", "").trim()
        int puerto = jint(jget(args, "port"), 8787)
        if host == "" or puerto < 1 or puerto > 65535 or host.contains("/") or host.contains(" "):
            return error_api("INVALID", "error.invalid").status(400)
        if host != ajuste("server_host", "") or str(puerto) != ajuste("server_port", "8787"):
            ajuste_poner("server_token", "")
            ajuste_poner("server_user", "")
            olvidar_enlaces()
            ajuste_poner("server_cuenta", "")
        ajuste_poner("server_host", host)
        ajuste_poner("server_port", str(puerto))
        state.remove("srv_caido")
        return await cmd_social("server_status", {})
    if cmd == "server_disconnect":
        ajuste_poner("server_host", "")
        ajuste_poner("server_token", "")
        ajuste_poner("server_user", "")
        return null
    if cmd == "server_logout":
        ajuste_poner("server_token", "")
        ajuste_poner("server_user", "")
        return null
    if cmd == "server_set_upload":
        ajuste_poner("server_upload", jget(args, "enabled") == true ? "1" : "0")
        return null
    if cmd == "server_login" or cmd == "server_register":
        if ajuste("server_host", "") == "":
            return error_api("SERVER_NOT_CONFIGURED", "error.server_not_configured").status(400)
        Dict<string, Json> cuerpo = { "username": arg_str(args, "username", ""), "password": arg_str(args, "password", "") }
        if cmd == "server_register":
            cuerpo["displayName"] = arg_str(args, "displayName", "")
        Dict<string, string> sin = {}
        Json r = null
        try:
            Json h = await http.post(srv_base() + (cmd == "server_login" ? "/login" : "/register"), cuerpo, sin, { "timeout_ms": 15000 })
            r = { "status": jint(h["status"], 0), "body": h["body"] }
        catch e:
            r = null
        return sesion_guardada(r)

    # a partir de aquí hace falta sesión
    if not srv_sesion():
        return error_api("SERVER_AUTH", "error.server_auth").status(401)

    # Aporta mi biblioteca descargada: lotes de 20 pistas por llamada (la UI repite
    # hasta done). Lo que el servidor ya tiene (por identidad) no se vuelve a subir.
    if cmd == "server_sync_library":
        int desde = jint(jget(args, "offset"), 0)
        List<Json> filas = await sqlite.query("""
            select t.id, t.title, t.artist_display as artist, coalesce(al.title, '') as album, t.duration_ms,
                   t.title_norm, t.artist_norm, af.rel_path, af.format,
                   (select count(*) from favorites fv where fv.track_id = t.id) as fav
            from audio_files af join tracks t on t.id = af.track_id left join albums al on al.id = t.album_id
            order by t.id limit 20 offset ?""", desde)
        List<Json> items = []
        for int i in range(0, len(filas)):
            items.add({ "id": filas[i]["id"], "titleNorm": filas[i]["title_norm"], "artistNorm": filas[i]["artist_norm"],
                        "durationMs": filas[i]["duration_ms"], "favorite": jint(filas[i]["fav"], 0) > 0 })
        int ya_estaban = 0
        int subidas = 0
        int fallidas = 0
        if len(items) > 0:
            Json? r = srv("POST", "/tracks/match", { "items": items })
            if r == null or r["status"] != 200:
                return srv_fallo(r)
            List<Json> res = jlist(r["body"])
            for int i in range(0, len(filas)):
                if jstr(res[i]["serverId"], "") != "":
                    ya_estaban = ya_estaban + 1
                    continue
                string ruta = ruta_audio_abs(jstr(filas[i]["rel_path"], ""))
                if os.is_file(ruta) and srv_poner(jstr(filas[i]["id"], ""), ruta, jstr(filas[i]["format"], "opus"), jstr(filas[i]["title"], ""),
                                                   jstr(filas[i]["artist"], ""), jstr(filas[i]["album"], ""), jint(filas[i]["duration_ms"], 0)):
                    subidas = subidas + 1
                else:
                    fallidas = fallidas + 1
            # todo lo que el servidor ya tiene (lo que estaba y lo recién subido) pasa a ser mi nube
            srv("PUT", "/library", { "items": items })
        return { "done": len(filas) < 20, "next": desde + 20, "alreadyThere": ya_estaban, "uploaded": subidas, "failed": fallidas }

    # "Descargar de la nube": trae lo que tengo guardado en el servidor (biblioteca,
    # favoritos y mis playlists) a este equipo. NUNCA baja lo que ya tengo: una pista
    # cuenta como tenida si hay audio en disco de esa misma canción (por id o por
    # título + artista + duración), aunque tenga otro id. Solo se encolan las que faltan;
    # la cola de descargas normal las trae (del servidor, que las tiene).
    if cmd == "server_pull":
        Json? r = srv("GET", "/library", null, 20000)
        if r == null or r["status"] != 200:
            return srv_fallo(r)
        List<Json> items = jlist(r["body"])
        int ya_tenia = 0
        int creadas = 0
        int encoladas = 0
        int favoritas = 0
        for int i in range(0, len(items)):
            PistaCatalogo p = srv_pista(items[i])
            string tn = jstr(items[i]["titleNorm"], "")
            if tn == "":
                tn = normalizar(p.title)
            string an = jstr(items[i]["artistNorm"], "")
            if an == "":
                an = normalizar(jstr(items[i]["artist"], ""))
            int dur = jint(items[i]["durationMs"], 0)
            # 1) ¿ya tengo el audio? (misma id, o la misma canción con otra)
            string tid = ""
            List<Json> propio = await sqlite.query("select 1 from audio_files where track_id = ?", p.id)
            if len(propio) > 0:
                tid = p.id
            else:
                tid = equivalente_local(tn, an, dur, "", true)
            if tid != "":
                ya_tenia = ya_tenia + 1
            else:
                # 2) no hay audio: la pista local si existe (sin descargar) o una nueva
                List<Json> existe = await sqlite.query("select 1 from tracks where id = ?", p.id)
                if len(existe) > 0:
                    tid = p.id
                else:
                    tid = equivalente_local(tn, an, dur, "", false)
                if tid == "":
                    guardar_pista(p)
                    tid = p.id
                    creadas = creadas + 1
                asegurar_descarga(tid, "prefetch")
                encoladas = encoladas + 1
            if jget(items[i], "favorite") == true:
                int antes = len(await sqlite.query("select 1 from favorites where track_id = ?", tid))
                await sqlite.exec("insert or ignore into favorites(track_id) values(?)", tid)
                if antes == 0:
                    favoritas = favoritas + 1
        # playlists: mis cambios suben, lo que hay en la nube baja (equipos nuevos incluidos)
        int antes_listas = len(await sqlite.query("select 1 from playlists"))
        srv_reconciliar()
        int listas = len(await sqlite.query("select 1 from playlists")) - antes_listas
        tocar_biblioteca()
        tocar_playlists()
        return { "total": len(items), "alreadyHad": ya_tenia, "created": creadas, "queued": encoladas,
                 "favorites": favoritas, "playlists": listas }

    if cmd == "social_me":
        Json? r = srv("GET", "/me")
        return r != null and r["status"] == 200 ? r["body"] : srv_fallo(r)
    if cmd == "social_update_me":
        Json? r = srv("PUT", "/me", { "displayName": arg_str(args, "displayName", ""), "bio": arg_str(args, "bio", "") })
        return r != null and r["status"] == 200 ? r["body"] : srv_fallo(r)
    if cmd == "social_users":
        Json? r = srv("GET", "/users")
        return r != null and r["status"] == 200 ? r["body"] : srv_fallo(r)
    if cmd == "social_user":
        Json? r = srv("GET", "/users/" + http.url_encode(arg_str(args, "username", "")))
        return r != null and r["status"] == 200 ? r["body"] : srv_fallo(r)
    if cmd == "social_playlists":
        Json? r = srv("GET", "/playlists")
        if r == null or r["status"] != 200:
            return srv_fallo(r)
        List<Json> out = []
        List<Json> ls = jlist(r["body"])
        for int i in range(0, len(ls)):
            Json p = ls[i]
            p["localId"] = local_de(str(p["id"]))
            out.add(p)
        return out
    if cmd == "social_playlist":
        string sid = arg_str(args, "id", "")
        Json? r = srv("GET", "/playlists/" + sid)
        if r == null or r["status"] != 200:
            return srv_fallo(r)
        Json p = r["body"]
        p["localId"] = local_de(sid)
        return p
    if cmd == "social_playlist_link":
        List<Json> f = await sqlite.query("select value from settings where key = ?", "srvpl:" + arg_str(args, "playlistId", ""))
        return len(f) == 0 ? null : jstr(f[0]["value"], "")

    # Compartir = cambiar la visibilidad / colaboración de una playlist (que ya vive en el servidor)
    if cmd == "social_publish" or cmd == "social_unpublish":
        string plid = arg_str(args, "playlistId", "")
        List<Json> pl = await sqlite.query("select name, coalesce(description, '') as d from playlists where id = ?", plid)
        if len(pl) == 0:
            return error_api("NOT_FOUND", "error.not_found").status(404)
        bool publica = cmd == "social_publish"
        string vis = publica ? arg_str(args, "visibility", "private") : "private"
        bool colab = false
        string sid = ajuste("srvpl:" + plid, "")
        if sid == "":
            sid = crear_en_servidor(plid, vis, colab)
            if sid == "":
                return srv_fallo(null)
            return { "localId": plid, "serverId": sid }
        sync_una(plid, sid)
        Json? r = srv("PUT", "/playlists/" + sid, { "name": jstr(pl[0]["name"], ""), "description": jstr(pl[0]["d"], ""),
            "visibility": vis, "collaborative": colab })
        if r == null or r["status"] >= 300:
            return srv_fallo(r)
        return { "localId": plid, "serverId": sid }
    # Asegura que la playlist local vive en el servidor y devuelve su ficha (miembros, visibilidad)
    if cmd == "social_ensure":
        string plid = arg_str(args, "playlistId", "")
        string sid = ajuste("srvpl:" + plid, "")
        if sid == "":
            sid = crear_en_servidor(plid)
            if sid == "":
                return srv_fallo(null)
        Json? r = srv("GET", "/playlists/" + sid)
        if r == null or r["status"] != 200:
            return srv_fallo(r)
        Json p = r["body"]
        p["localId"] = plid
        return p
    if cmd == "social_sync":
        string plid = arg_str(args, "playlistId", "")
        string sid = ajuste("srvpl:" + plid, "")
        if sid == "":
            return error_api("NOT_FOUND", "error.not_found").status(404)
        return sync_una(plid, sid)
    # traer a mi biblioteca una playlist del servidor (de otra persona, compartida o pública)
    if cmd == "social_import":
        return importar_playlist(arg_str(args, "id", ""))
    if cmd == "social_add_member":
        Json? r = srv("POST", "/playlists/" + arg_str(args, "id", "") + "/members", { "username": arg_str(args, "username", "") })
        if r != null and r["status"] == 404:
            return error_api("USER_NOT_FOUND", "error.user_not_found").status(404)
        return r != null and r["status"] < 300 ? null : srv_fallo(r)
    if cmd == "social_remove_member":
        Json? r = srv("DELETE", "/playlists/" + arg_str(args, "id", "") + "/members/" + http.url_encode(arg_str(args, "username", "")))
        return r != null and r["status"] < 300 ? null : srv_fallo(r)
    return error_api("UNKNOWN_COMMAND", "error.unknown_command").status(404)
