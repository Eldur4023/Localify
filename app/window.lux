# window.lux — Minimizar y restaurar la ventana desde fuera de ella.

# No hay modo --headless (a diferencia del original), pero el binario SÍ
# acepta ahora un flag nativo --minimized (runtime.cpp, DesktopWindow::
# Options::start_minimized) que arranca la ventana ya iconificada desde el
# primer frame -- el arranque en sesión debería pasar ese flag directamente
# en vez de usar este endpoint. Este endpoint se queda para minimizar una
# ventana YA en marcha bajo demanda, un caso distinto de "arrancar minimizado".
post endpoint("/api/window/minimize"):
    window.minimize()
    return status(204)

# Cuando el candado de instancia única rechaza un segundo lanzamiento
# (icono del menú, doble clic...), main() llama aquí antes de salir en vez
# de no hacer nada: sin esto, "abrir la app" con la ventana ya minimizada
# no tenía ningún efecto visible, y parecía que hacía falta intentarlo
# varias veces para que "abriera".
post endpoint("/api/window/restore"):
    window.restore()
    return status(204)
