# ytmovil.lux — Descargas en el móvil, que no tiene yt-dlp.
#
# Las URLs de googlevideo van firmadas con la IP que las pidió: resolverlas
# en otra máquina (PC, servidor) y bajarlas desde el teléfono da 403 en cuanto
# el móvil sale por datos. Así que el móvil hace las dos cosas con SU IP:
#
#   1. resuelve la URL directa con InnerTube (cliente ANDROID_VR: da URLs
#      directas, sin cifrar ni PO token)
#   2. baja los bytes (con `range=0-N` en la URL: sin él googlevideo estrangula)
#   3. si hay servidor común, le sube el crudo (PUT /relay/:id → MP3 320k
#      etiquetado) y se lleva el MP3 con srv_obtener(); si no, el crudo
#      se queda tal cual (finalizar() lo respeta cuando no hay ffmpeg)

fn bool descarga_movil():
    return en_movil()

# Clientes InnerTube que dan URLs directas (sin cifrar ni PO token). YouTube
# los marca como bot de forma intermitente y por cliente, de ahí la cascada.
fn List<Json> yt_clientes():
    return [
        { "ua": "Mozilla/5.0 (Macintosh; Intel Mac OS X 15_7_3) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/26.0 Safari/605.1.15",
          "hn": "101", "hv": "1.02", "vd": true,
          "client": { "clientName": "VISIONOS", "clientVersion": "1.02", "deviceMake": "Apple",
                      "deviceModel": "RealityDevice17,1", "osName": "visionOS", "osVersion": "26.5.23O471", "hl": "en" } },
        { "ua": "com.google.android.apps.youtube.vr.oculus/1.60.19 (Linux; U; Android 12L) gzip",
          "client": { "clientName": "ANDROID_VR", "clientVersion": "1.60.19", "deviceMake": "Oculus",
                      "deviceModel": "Quest 3", "osName": "Android", "osVersion": "12L", "androidSdkVersion": 32, "hl": "en" } },
        { "ua": "com.google.ios.youtube/20.10.4 (iPhone16,2; U; CPU iOS 18_3_2 like Mac OS X;)",
          "client": { "clientName": "IOS", "clientVersion": "20.10.4", "deviceMake": "Apple",
                      "deviceModel": "iPhone16,2", "osName": "iPhone", "osVersion": "18.3.2.22D82", "hl": "en" } },
        { "ua": "com.google.android.youtube/20.10.38 (Linux; U; Android 11) gzip",
          "client": { "clientName": "ANDROID", "clientVersion": "20.10.38", "androidSdkVersion": 30,
                      "osName": "Android", "osVersion": "11", "hl": "en" } }
    ]

# visitorData de la página del vídeo (con él, el bot-check de YouTube deja
# pasar a VISIONOS donde sin él pide login). Cacheado: vale para horas.
fn string yt_visitor(string vid):
    string vd = state.get("yt_vd", "")
    if vd != "":
        return vd
    try:
        Json? w = await http.get("https://www.youtube.com/watch?v=" + vid, { "User-Agent": "Mozilla/5.0" }, { "timeout_ms": 20000 })
        if w == null or jint(w["status"], 0) != 200:
            return ""
        string h = jstr(w["body"], "")
        string clave = "\"visitorData\":\""
        int i = h.index_of(clave)
        if i < 0:
            return ""
        string resto = h.slice(i + len(clave), i + len(clave) + 2000)
        vd = resto.slice(0, resto.index_of("\""))
        state.set("yt_vd", vd, 3600000)
    catch e:
        return ""
    return vd

# El mejor audio que da el cliente `c` de yt_clientes(); null si no hay.
fn Json? yt_audio_directo(string vid, int c):
    Json cl = yt_clientes()[c]
    Json ctx = cl["client"]
    Dict<string, string> cab = { "User-Agent": jstr(cl["ua"], "") }
    if jget(cl, "vd") == true:
        string vd = yt_visitor(vid)
        if vd != "":
            ctx["visitorData"] = vd
            cab["X-Goog-Visitor-Id"] = vd
            cab["X-YouTube-Client-Name"] = jstr(cl["hn"], "")
            cab["X-YouTube-Client-Version"] = jstr(cl["hv"], "")
    Dict cuerpo = { "context": { "client": ctx }, "videoId": vid,
                    "contentCheckOk": true, "racyCheckOk": true }
    Json? r = null
    try:
        r = await http.post("https://www.youtube.com/youtubei/v1/player?prettyPrint=false", cuerpo, cab, { "timeout_ms": 20000 })
    catch e:
        state.set("ytvr_err", "exc " + str(e))
        return null
    if r == null or jint(r["status"], 0) != 200:
        state.set("ytvr_err", "http " + (r == null ? "null" : str(jint(r["status"], 0))))
        return null
    List<Json> fs = jlist(jget(jget(r["body"], "streamingData"), "adaptiveFormats"))
    Json? mejor = null
    int mejor_br = 0
    for int i in range(0, len(fs)):
        if not jstr(fs[i]["mimeType"], "").starts_with("audio"):
            continue
        if jstr(fs[i]["url"], "") == "" or jint(fs[i]["contentLength"], 0) < 16384:
            continue
        if jint(fs[i]["bitrate"], 0) > mejor_br:
            mejor = fs[i]
            mejor_br = jint(fs[i]["bitrate"], 0)
    if mejor == null:
        state.set("ytvr_err", jstr(jget(jget(r["body"], "playabilityStatus"), "status"), "?"))
    return mejor

# Baja el audio de `vid` al temporal probando cada cliente hasta que uno
# sirva los bytes (URL y descarga fallan por separado: un 403 es del cliente).
# Devuelve la ruta, o "" con los motivos en state "ytvr_err".
fn string yt_bajar(string tid, string vid):
    string motivos = ""
    for int c in range(0, len(yt_clientes())):
        Json? f = yt_audio_directo(vid, c)
        string nombre = jstr(yt_clientes()[c]["client"]["clientName"], "")
        if f == null:
            motivos = motivos + " " + nombre + ":" + state.get("ytvr_err", "?")
            continue
        string ext = jstr(f["mimeType"], "").contains("webm") ? "webm" : "m4a"
        string destino = os.path_join(biblioteca_raiz(), ".tmp", tid + ".yt." + ext)
        int total = jint(f["contentLength"], 0)
        try:
            Json? d = await http.get(jstr(f["url"], "") + "&range=0-" + str(total - 1), {}, { "save_to": destino, "timeout_ms": 120000 })
            if d != null and jint(d["status"], 0) < 300 and os.file_size(destino) >= total:
                return destino
            motivos = motivos + " " + nombre + ":get" + (d == null ? "null" : str(jint(d["status"], 0)))
        catch e:
            motivos = motivos + " " + nombre + ":getexc"
        if os.is_file(destino):
            os.remove_file(destino)
    state.set("ytvr_err", motivos)
    return ""

# "" = el trabajo quedó en 'finalizing' con tmp_path; si no, la clave del error.
fn string descargar_movil(string tid, string video_id):
    garantizar_biblioteca()
    string destino = yt_bajar(tid, video_id)
    if destino == "":
        return "download.mobile:" + state.get("ytvr_err", "")
    # con servidor: él transcodifica y nos devuelve el MP3
    if srv_activo():
        List<Json> m = await sqlite.query("""
            select t.title, t.artist_display, t.duration_ms,
                   (select al.title from albums al where al.id = t.album_id) as album
            from tracks t where t.id = ?""", tid)
        if len(m) > 0:
            string titulo = jstr(m[0]["title"], "")
            string artista = jstr(m[0]["artist_display"], "")
            string album = jstr(m[0]["album"], "")
            Dict<string, string> cab = { "Authorization": "Bearer " + ajuste("server_token", "") }
            try:
                Json? u = await http.put(srv_base() + "/relay/" + tid, {
                    "title": titulo, "artist": artista, "album": album,
                    "duration_ms": str(jint(m[0]["duration_ms"], 0)),
                    "search_norm": normalizar(titulo + " " + artista + " " + album),
                    "title_norm": normalizar(titulo), "artist_norm": normalizar(artista)
                }, cab, { "files": { "audio": destino }, "timeout_ms": 120000 })
                if u != null and jint(u["status"], 0) < 300 and srv_obtener(tid):
                    os.remove_file(destino)
                    return ""
            catch e:
                state.set("srv_caido", "1", 30000)
    int tocado = await sqlite.exec("""
        update download_jobs set tmp_path = ?, state = 'finalizing', updated_at = unixepoch()
        where track_id = ? and state = 'downloading'""", destino, tid)
    return tocado == 1 ? "" : "download.mobile_state"
