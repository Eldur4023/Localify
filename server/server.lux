# server.lux — Serverify: servidor común (opcional) para clientes Localify.
#
# Es solo un índice compartido: usuarios, perfiles, playlists como REFERENCIAS
# (la música y las playlists reales siguen en local en cada cliente) y un
# almacén de audio que los propios clientes rellenan tras descargar. El
# servidor NUNCA descarga nada (ni yt-dlp ni red externa): si no tiene una
# canción, el cliente usa su método de siempre.
#
#   cd server && JWT_SECRET=<secreto largo> lux server.lux     # puerto 8787
#   SERVERIFY_HOST=<ip> limita la escucha a una interfaz (p. ej. la de Tailscale).
#   (hay que lanzarlo desde server/: ./data y la BD cuelgan de ahí)
#
# Datos en ./data (serverify.db + audio/), relativo al directorio de trabajo.

import sqlite
import hash
import os
import json
import time

app:
    name     "Serverify"
    port     8787
    host     env("SERVERIFY_HOST", "0.0.0.0")
    max_body "256MB"

    jwt:
        secret env("JWT_SECRET")

    sqlite:
        file "./data/serverify.db"
        pool 4

on start:
    os.make_dir("data")
    os.make_dir("data/audio")
    await sqlite.exec("""
        create table if not exists users(
            id integer primary key,
            username text not null unique collate nocase,
            display_name text not null,
            bio text not null default '',
            pass_hash text not null,
            created_at integer not null default (unixepoch())
        )""")
    await sqlite.exec("""
        create table if not exists presence(
            user_id integer primary key references users(id) on delete cascade,
            title text not null default '', artist text not null default '',
            updated_at integer not null default (unixepoch())
        )""")
    # Reproducción sincronizada entre equipos del mismo usuario: una sola fila (el último que
    # escribe gana). `at` es la hora del SERVIDOR (ms) a la que `position_ms` era cierta, así
    # el receptor extrapola sin depender de que los relojes de los equipos coincidan.
    await sqlite.exec("""
        create table if not exists playback(
            user_id integer primary key references users(id) on delete cascade,
            rev integer not null default 0,
            device_id text not null default '',
            track_key text not null default '',
            state text not null default '{}',
            at integer not null default 0
        )""")
    await sqlite.exec("""
        create table if not exists devices(
            user_id integer not null references users(id) on delete cascade,
            device_id text not null,
            name text not null default '', platform text not null default '',
            last_seen integer not null default 0,
            primary key(user_id, device_id)
        )""")
    await sqlite.exec("""
        create table if not exists plays(
            user_id integer not null references users(id) on delete cascade,
            track_id text not null,
            played_at integer not null,
            completed integer not null default 0,
            primary key(user_id, track_id, played_at)
        )""")
    if len(await sqlite.query("select 1 from pragma_table_info('plays') where name = 'ms_played'")) == 0:
        await sqlite.exec("alter table plays add column ms_played integer not null default 0")
    await sqlite.exec("""
        create table if not exists tracks(
            id text primary key,
            title text not null, artist text not null default '', album text not null default '',
            duration_ms integer not null default 0,
            search_norm text not null default '',
            title_norm text not null default '', artist_norm text not null default '',
            ext text not null, size integer not null,
            uploaded_by integer references users(id) on delete set null,
            created_at integer not null default (unixepoch())
        )""")
    await sqlite.exec("create index if not exists idx_tracks_key on tracks(title_norm, artist_norm)")
    # La biblioteca de cada usuario (su "nube"): qué pistas del servidor son suyas y cuáles
    # son favoritas. El audio es compartido (tracks); esto solo dice de quién es qué.
    await sqlite.exec("""
        create table if not exists user_tracks(
            user_id integer not null references users(id) on delete cascade,
            track_id text not null references tracks(id) on delete cascade,
            favorite integer not null default 0,
            added_at integer not null default (unixepoch()),
            primary key(user_id, track_id)
        )""")
    await sqlite.exec("""
        create table if not exists playlists(
            id integer primary key,
            owner_id integer not null references users(id) on delete cascade,
            name text not null, description text not null default '',
            visibility text not null default 'private' check(visibility in ('public','private')),
            collaborative integer not null default 0,
            updated_at integer not null default (unixepoch())
        )""")
    # Playlists borradas: para que los demás equipos del usuario (y los miembros) sepan que se
    # borró a propósito y no la vuelvan a crear al sincronizar.
    await sqlite.exec("""
        create table if not exists playlist_tombstones(
            user_id integer not null references users(id) on delete cascade,
            playlist_id integer not null,
            primary key(user_id, playlist_id)
        )""")
    await sqlite.exec("""
        create table if not exists playlist_members(
            playlist_id integer not null references playlists(id) on delete cascade,
            user_id integer not null references users(id) on delete cascade,
            status text not null default 'accepted' check(status in ('pending','accepted')),
            primary key(playlist_id, user_id)
        )""")
    # bases creadas antes de las invitaciones: sus miembros ya estaban dentro -> aceptados
    List<Json> cols = await sqlite.query("pragma table_info(playlist_members)")
    bool tiene_estado = false
    for int i in range(0, len(cols)):
        if str(cols[i]["name"]) == "status":
            tiene_estado = true
    if not tiene_estado:
        await sqlite.exec("alter table playlist_members add column status text not null default 'accepted'")
    await sqlite.exec("""
        create table if not exists playlist_tracks(
            playlist_id integer not null references playlists(id) on delete cascade,
            position integer not null,
            track_id text not null,
            title text not null, artist text not null default '', album text not null default '',
            duration_ms integer not null default 0,
            title_norm text not null default '', artist_norm text not null default '',
            added_by integer references users(id) on delete set null,
            primary key(playlist_id, position)
        )""")

# ─── Utilidades ──────────────────────────────────────────────────────────────

fn string s_of(Json j, string clave, string def):
    if j == null or j[clave] == null:
        return def
    return str(j[clave])

fn int i_of(Json j, string clave, int def):
    if j == null or j[clave] == null:
        return def
    return int(j[clave])

# Adaptadores del módulo json nativo (los mismos del app/, en versión mínima:
# el servidor parsea respuestas de ffprobe/yt-dlp).
fn Json? parse_json(string s):
    try:
        return json.parse(s)
    catch e:
        return null

fn Json jget(Json j, string key):
    if j == null:
        return null
    return j[key]

fn string jstr(Json j, string def):
    if j == null:
        return def
    return str(j)

fn int jint(Json j, int def):
    if j == null:
        return def
    return int(j)

fn double jdbl(Json j, double def):
    if j == null:
        return def
    # como en app/json.lux: ffprobe/yt-dlp mandan números como string JSON
    Json? n = parse_json(str(j))
    if n == null:
        return def
    return n * 1.0

fn int yo():
    return int(jwt.claims["sub"])

fn string like_esc(string s):
    return s.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")

# id de pista: lo manda el cliente; solo se admite un alfabeto seguro porque
# acaba formando una ruta de fichero
fn bool id_valido(string id):
    if len(id) < 1 or len(id) > 64:
        return false
    string ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
    for int i in range(0, len(id)):
        if not ok.contains(id.slice(i, i + 1)):
            return false
    return true

fn Json user_dto(Json u):
    return { "username": u["username"], "displayName": u["display_name"], "bio": u["bio"],
             "hasAvatar": os.is_file("./data/avatars/" + str(u["id"]) + ".jpg") }

# Identidad de una canción: título + artista normalizados (los normaliza el
# cliente, con la misma función que su biblioteca) y, para no mezclar versiones
# distintas con el mismo nombre, una duración compatible (±3 s; 0 = desconocida).
# Devuelve el id de la pista del servidor, o "" si no hay.
fn string id_por_identidad(string titulo_norm, string artista_norm, int duracion_ms):
    if titulo_norm == "":
        return ""
    List<Json> r = await sqlite.query("""
        select id from tracks where title_norm = ? and artist_norm = ?
          and (duration_ms = 0 or ? = 0 or abs(duration_ms - ?) <= 3000)
        order by created_at limit 1""", titulo_norm, artista_norm, duracion_ms, duracion_ms)
    return len(r) == 0 ? "" : str(r[0]["id"])

# La pista de una referencia (por id o, si no, por identidad), "" si el servidor no la tiene
fn string id_de_referencia(string id, string titulo_norm, string artista_norm, int duracion_ms):
    List<Json> r = await sqlite.query("select id from tracks where id = ?", id)
    if len(r) > 0:
        return id
    return id_por_identidad(titulo_norm, artista_norm, duracion_ms)

# nivel de acceso a una playlist: "owner" | "member" | "reader" | "" (ninguno)
fn string acceso(int pid, int uid):
    List<Json> p = await sqlite.query("select owner_id, visibility from playlists where id = ?", pid)
    if len(p) == 0:
        return ""
    if int(p[0]["owner_id"]) == uid:
        return "owner"
    List<Json> m = await sqlite.query("select 1 from playlist_members where playlist_id = ? and user_id = ? and status = 'accepted'", pid, uid)
    if len(m) > 0:
        return "member"
    return p[0]["visibility"] == "public" ? "reader" : ""

# Una playlist es conjunta cuando su dueña invita a alguien: quien está en la lista de
# miembros puede tocar las canciones. Nadie más (los lectores de una pública, tampoco).
fn bool puede_editar_pistas(string nivel):
    return nivel == "owner" or nivel == "member"

fn Json playlist_resumen(Json p):
    return {
        "id": p["id"], "name": p["name"], "description": p["description"],
        "visibility": p["visibility"], "collaborative": int(p["n_members"]) > 0,
        "owner": p["owner"], "ownerName": p["owner_name"],
        "nTracks": p["n_tracks"], "updatedAt": p["updated_at"],
        "hasCover": os.is_file("./data/pcovers/" + str(p["id"]) + ".jpg"),
        "coverSize": os.is_file("./data/pcovers/" + str(p["id"]) + ".jpg") ? os.file_size("./data/pcovers/" + str(p["id"]) + ".jpg") : 0
    }

fn string sql_resumen():
    return """
        select p.id, p.name, p.description, p.visibility, p.collaborative, p.updated_at,
               u.username as owner, u.display_name as owner_name,
               (select count(*) from playlist_tracks pt where pt.playlist_id = p.id) as n_tracks,
               (select count(*) from playlist_members pm where pm.playlist_id = p.id and pm.status = 'accepted') as n_members
        from playlists p join users u on u.id = p.owner_id """

# ¿Ya está esta canción en la lista? (mismo id o misma identidad título + artista)
fn bool ya_en_playlist(int pid, string tid, string titulo_norm, string artista_norm):
    List<Json> r = await sqlite.query("""
        select 1 from playlist_tracks where playlist_id = ?
          and (track_id = ? or (? != '' and title_norm = ? and artist_norm = ?)) limit 1""",
        pid, tid, titulo_norm, titulo_norm, artista_norm)
    return len(r) > 0

fn void insertar_pista(int pid, Json p, int uid):
    string tid = s_of(p, "id", "")
    string tn = s_of(p, "titleNorm", "")
    string an = s_of(p, "artistNorm", "")
    if tid == "" or s_of(p, "title", "") == "" or ya_en_playlist(pid, tid, tn, an):
        return
    await sqlite.exec("""
        insert into playlist_tracks(playlist_id, position, track_id, title, artist, album, duration_ms, title_norm, artist_norm, added_by)
        values(?, (select coalesce(max(position) + 1, 0) from playlist_tracks where playlist_id = ?), ?, ?, ?, ?, ?, ?, ?, ?)""",
        pid, pid, tid, s_of(p, "title", ""), s_of(p, "artist", ""), s_of(p, "album", ""),
        i_of(p, "durationMs", 0), tn, an, uid)

# Sustituye las pistas de una playlist por la lista dada (referencias, sin repetidas).
fn void escribir_pistas(int pid, List<Json> pistas, int uid):
    await sqlite.exec("delete from playlist_tracks where playlist_id = ?", pid)
    for int i in range(0, len(pistas)):
        insertar_pista(pid, pistas[i], uid)
    await sqlite.exec("update playlists set updated_at = unixepoch() where id = ?", pid)

# ─── Público ─────────────────────────────────────────────────────────────────

get endpoint("/api/info"):
    return { "name": "Serverify", "version": 1 }

post endpoint("/api/register", Json b):
    if state.incr("reg:" + request.ip, 1, 3600000) > 20:
        return { "error": "rate_limited" }.status(429)
    string user = s_of(b, "username", "").trim()
    string pass = s_of(b, "password", "")
    if len(user) < 3 or len(user) > 32 or len(pass) < 8 or user.contains(" ") or user.contains("/"):
        return { "error": "invalid" }.status(400)
    string nombre = s_of(b, "displayName", user).trim().slice(0, 40)
    if nombre == "":
        nombre = user
    string h = await hash.password(pass)
    try:
        await sqlite.exec("insert into users(username, display_name, pass_hash) values(?, ?, ?)", user, nombre, h)
    catch e:
        return { "error": "username_taken" }.status(409)
    int id = await sqlite.last_id()
    return { "token": jwt.sign({ "sub": str(id) }, 2592000), "user": { "username": user, "displayName": nombre, "bio": "" } }.status(201)

post endpoint("/api/login", Json b):
    if state.incr("login:" + request.ip, 1, 60000) > 10:
        return { "error": "rate_limited" }.status(429)
    List<Json> r = await sqlite.query("select * from users where username = ?", s_of(b, "username", ""))
    # misma respuesta para usuario inexistente y contraseña errónea
    if len(r) == 0 or not await hash.verify(s_of(b, "password", ""), str(r[0]["pass_hash"])):
        return { "error": "bad_credentials" }.status(401)
    return { "token": jwt.sign({ "sub": str(r[0]["id"]) }, 2592000), "user": user_dto(r[0]) }

# ─── Autenticado ─────────────────────────────────────────────────────────────

group("/api"):
    require jwt.valid else status(401)

    get endpoint("/me"):
        List<Json> r = await sqlite.query("select * from users where id = ?", yo())
        if len(r) == 0:
            return status(401)
        return user_dto(r[0])

    put endpoint("/me", Json b):
        await sqlite.exec("update users set display_name = coalesce(nullif(?, ''), display_name), bio = ? where id = ?",
            s_of(b, "displayName", "").trim().slice(0, 40), s_of(b, "bio", "").slice(0, 160), yo())
        List<Json> r = await sqlite.query("select * from users where id = ?", yo())
        return user_dto(r[0])

    # foto de perfil (la sube su dueño; la ven todos los usuarios)
    put endpoint("/me/avatar", File avatar):
        if avatar.size < 100:
            return { "error": "invalid" }.status(400)
        os.make_dir("data/avatars")
        # save() NO sobrescribe: si ya hay foto crea "<id>-xxxx.jpg" y se seguía sirviendo la vieja
        os.remove_file("./data/avatars/" + str(yo()) + ".jpg")
        avatar.save("./data/avatars", str(yo()) + ".jpg")
        return status(204)

    get endpoint("/users/:name/avatar", string name):
        List<Json> r = await sqlite.query("select id from users where username = ?", name)
        if len(r) == 0 or not os.is_file("./data/avatars/" + str(r[0]["id"]) + ".jpg"):
            return status(404)
        return send_file("./data/avatars/" + str(r[0]["id"]) + ".jpg")

    # ── escuchando ahora ──
    # El cliente avisa al cambiar de canción (title vacío = parado) y repite cada
    # minuto mientras suena; pasados 150 s sin aviso se considera que no escucha.
    put endpoint("/presence", Json b):
        await sqlite.exec("""insert into presence(user_id, title, artist, updated_at) values(?, ?, ?, unixepoch())
            on conflict(user_id) do update set title = excluded.title, artist = excluded.artist, updated_at = unixepoch()""",
            yo(), s_of(b, "title", "").slice(0, 200), s_of(b, "artist", "").slice(0, 200))
        return status(204)

    # ── reproducción sincronizada ──
    # PUT: un equipo publica lo que suena (pista + ventana de cola + posición + play/pausa).
    # kind "auto" = avance por fin de canción: lo mandan TODOS los equipos a la vez, y solo vale
    # el primero (`after` es la pista que acabó; si el estado ya pasó de ella, se ignora).
    put endpoint("/playback", Json b):
        string dev = s_of(b, "deviceId", "")
        if not id_valido(dev):
            return { "error": "invalid" }.status(400)
        string clave = s_of(b, "trackKey", "").slice(0, 200)
        if len(str(b["state"])) > 20000:
            return { "error": "too_large" }.status(413)
        List<Json> r = await sqlite.query("select rev, track_key from playback where user_id = ?", yo())
        if len(r) > 0 and s_of(b, "kind", "set") == "auto" and str(r[0]["track_key"]) != s_of(b, "after", ""):
            return { "rev": r[0]["rev"], "ignored": true }
        int ahora = int(time.now())
        await sqlite.exec("""insert into playback(user_id, rev, device_id, track_key, state, at) values(?, 1, ?, ?, ?, ?)
            on conflict(user_id) do update set rev = rev + 1, device_id = excluded.device_id,
                track_key = excluded.track_key, state = excluded.state, at = excluded.at""",
            yo(), dev, clave, str(b["state"]), ahora)
        r = await sqlite.query("select rev from playback where user_id = ?", yo())
        return { "rev": r[0]["rev"], "now": ahora }

    # GET: 204 si no hay nada nuevo desde `since` (barato: se llama cada segundo)
    get endpoint("/playback", int since = 0):
        List<Json> r = await sqlite.query("select rev, device_id, state, at from playback where user_id = ?", yo())
        if len(r) == 0 or int(r[0]["rev"]) == since:
            return status(204)
        Json st = parse_json(str(r[0]["state"]))
        return { "rev": r[0]["rev"], "deviceId": r[0]["device_id"], "at": r[0]["at"],
                 "now": int(time.now()), "state": st == null ? {} : st }

    # los equipos se anuncian (nombre + plataforma) y se listan en el perfil
    put endpoint("/devices", Json b):
        string dev = s_of(b, "deviceId", "")
        if not id_valido(dev):
            return { "error": "invalid" }.status(400)
        await sqlite.exec("""insert into devices(user_id, device_id, name, platform, last_seen) values(?, ?, ?, ?, unixepoch())
            on conflict(user_id, device_id) do update set name = excluded.name, platform = excluded.platform, last_seen = unixepoch()""",
            yo(), dev, s_of(b, "name", "").slice(0, 60), s_of(b, "platform", "").slice(0, 20))
        return status(204)

    get endpoint("/devices"):
        List<Json> r = await sqlite.query("""select device_id, name, platform, last_seen,
            (unixepoch() - last_seen) as ago from devices where user_id = ? order by last_seen desc limit 20""", yo())
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add({ "deviceId": r[i]["device_id"], "name": r[i]["name"], "platform": r[i]["platform"],
                      "agoS": r[i]["ago"] })
        return out

    # equipo dado de baja a mano desde el perfil
    delete endpoint("/devices/:id", string id):
        await sqlite.exec("delete from devices where user_id = ? and device_id = ?", yo(), id)
        return status(204)

    # ── usuarios (Social) ──
    get endpoint("/users"):
        List<Json> r = await sqlite.query("""
            select u.username, u.display_name, u.bio,
                   (select count(*) from playlists p where p.owner_id = u.id and p.visibility = 'public') as n_playlists,
                   (select count(*) from tracks t where t.uploaded_by = u.id) as n_tracks,
                   u.id,
                   (select title from presence x where x.user_id = u.id and x.updated_at > unixepoch() - 150) as np_title,
                   (select artist from presence x where x.user_id = u.id and x.updated_at > unixepoch() - 150) as np_artist
            from users u order by u.display_name collate nocase""")
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add({ "username": r[i]["username"], "displayName": r[i]["display_name"], "bio": r[i]["bio"],
                      "nPlaylists": r[i]["n_playlists"], "nTracks": r[i]["n_tracks"],
                      "hasAvatar": os.is_file("./data/avatars/" + str(r[i]["id"]) + ".jpg") })
            if jstr(r[i]["np_title"], "") != "":
                out[i]["nowPlaying"] = { "title": r[i]["np_title"], "artist": r[i]["np_artist"] }
        return out

    get endpoint("/users/:name", string name):
        List<Json> r = await sqlite.query("select * from users where username = ?", name)
        if len(r) == 0:
            return status(404)
        List<Json> ps = await sqlite.query(sql_resumen() + " where p.owner_id = ? and p.visibility = 'public' order by p.updated_at desc", int(r[0]["id"]))
        List<Json> pl = []
        for int i in range(0, len(ps)):
            pl.add(playlist_resumen(ps[i]))
        Json dto = user_dto(r[0])
        dto["playlists"] = pl
        # escaparate: lo más escuchado (90 días) y lo que suena ahora
        List<Json> top = await sqlite.query("""
            select t.id, t.title, t.artist, sum(p.ms_played) as n from plays p join tracks t on t.id = p.track_id
            where p.user_id = ? and p.played_at > unixepoch() - 7776000
            group by p.track_id order by n desc, max(p.played_at) desc limit 8""", int(r[0]["id"]))
        List<Json> tops = []
        for int i in range(0, len(top)):
            tops.add({ "id": top[i]["id"], "title": top[i]["title"], "artist": top[i]["artist"], "ms": top[i]["n"] })
        dto["topTracks"] = tops
        List<Json> tot = await sqlite.query("select coalesce(sum(ms_played), 0) as n from plays where user_id = ? and played_at > unixepoch() - 7776000", int(r[0]["id"]))
        dto["listenedMs"] = tot[0]["n"]
        List<Json> np = await sqlite.query("select title, artist from presence where user_id = ? and title != '' and updated_at > unixepoch() - 150", int(r[0]["id"]))
        if len(np) > 0:
            dto["nowPlaying"] = { "title": np[0]["title"], "artist": np[0]["artist"] }
        return dto

    # ── catálogo de audio ──
    # q llega ya normalizado por el cliente (misma normalización que su BD local)
    get endpoint("/tracks/search", string q = "", int limit = 20):
        List<string> t = []
        List<string> crudo = q.trim().split(" ")
        for int i in range(0, len(crudo)):
            if crudo[i] != "":
                t.add(crudo[i])
        List<string> p = []
        for int i in range(0, 6):
            p.add(i < len(t) ? "%" + like_esc(t[i]) + "%" : "%")
        if len(t) == 0:
            return []
        if limit > 50:
            limit = 50
        List<Json> r = await sqlite.query("""
            select id, title, artist, album, duration_ms, title_norm, artist_norm from tracks
            where search_norm like ? escape '\\' and search_norm like ? escape '\\' and search_norm like ? escape '\\'
              and search_norm like ? escape '\\' and search_norm like ? escape '\\' and search_norm like ? escape '\\'
            order by created_at limit ?""", p[0], p[1], p[2], p[3], p[4], p[5], limit * 3)
        List<Json> out = []
        List<string> vistas = []
        for int i in range(0, len(r)):
            if len(out) >= limit:
                break
            # una sola fila por canción: título + artista + duración compatible
            string clave = str(r[i]["title_norm"]) + "|" + str(r[i]["artist_norm"]) + "|" + str(int(r[i]["duration_ms"]) / 3000)
            if r[i]["title_norm"] != "" and vistas.contains(clave):
                continue
            vistas.add(clave)
            out.add({ "id": r[i]["id"], "title": r[i]["title"], "artist": r[i]["artist"],
                      "album": r[i]["album"], "durationMs": r[i]["duration_ms"] })
        return out

    # Qué pistas del cliente tiene ya el servidor, por identidad (título + artista
    # normalizados + duración) o por id: [{id, titleNorm, artistNorm, durationMs}]
    # -> [{id, serverId}] con serverId "" si no la tiene (hasta 200)
    post endpoint("/tracks/match", Json b):
        List<Json> items = b["items"] == null ? [] : b["items"]
        List<Json> out = []
        for int i in range(0, len(items)):
            if i >= 200:
                break
            string cid = s_of(items[i], "id", "")
            out.add({ "id": cid, "serverId": id_de_referencia(cid, s_of(items[i], "titleNorm", ""), s_of(items[i], "artistNorm", ""), i_of(items[i], "durationMs", 0)) })
        return out

    # ids que el servidor ya tiene, de una lista (hasta 100)
    post endpoint("/tracks/have", Json b):
        List<Json> ids = b["ids"] == null ? [] : b["ids"]
        List<string> have = []
        for int i in range(0, len(ids)):
            if i >= 100:
                break
            List<Json> r = await sqlite.query("select 1 from tracks where id = ?", str(ids[i]))
            if len(r) > 0:
                have.add(str(ids[i]))
        return have

    get endpoint("/tracks/:id/audio", string id):
        List<Json> r = await sqlite.query("select ext from tracks where id = ?", id)
        if len(r) == 0 or not id_valido(id):
            return status(404)
        return send_file("./data/audio/" + id + "." + str(r[0]["ext"]))

    # subida: el cliente que acaba de descargar una pista la aporta al servidor
    put endpoint("/tracks/:id", string id, File audio, string title = "", string artist = "", string album = "", int duration_ms = 0, string search_norm = "", string title_norm = "", string artist_norm = "", string ext = "opus"):
        if not id_valido(id):
            return { "error": "invalid_id" }.status(400)
        if not ["opus", "ogg", "webm", "m4a", "mp3", "flac"].contains(ext):
            return { "error": "invalid_ext" }.status(400)
        string titulo = title.trim()
        if titulo == "" or audio.size < 16384:
            return { "error": "invalid" }.status(400)
        List<Json> ya = await sqlite.query("select 1 from tracks where id = ?", id)
        if len(ya) > 0:
            return { "stored": false, "id": id }
        # la misma canción subida por otra persona con otro id: no se duplica
        string igual = id_por_identidad(title_norm, artist_norm, duration_ms)
        if igual != "":
            return { "stored": false, "id": igual, "duplicate": true }
        os.remove_file("./data/audio/" + id + "." + ext)   # save() no sobrescribe (resto de un intento fallido)
        audio.save("./data/audio", id + "." + ext)
        await sqlite.exec("""
            insert or ignore into tracks(id, title, artist, album, duration_ms, search_norm, title_norm, artist_norm, ext, size, uploaded_by)
            values(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
            id, titulo, artist, album, duration_ms,
            search_norm.trim(), title_norm.trim(), artist_norm.trim(), ext, audio.size, yo())
        return { "stored": true, "id": id }.status(201)

    # ── relay de descargas ──
    # El servidor NO toca YouTube: el cliente (móvil, sin yt-dlp) resuelve y
    # baja los bytes con su propia IP (las URLs de googlevideo van ligadas a
    # ella) y aquí solo se transcodifican a MP3 etiquetado para repartirlos.
    # El cliente aporta el fichero crudo que bajó con su IP; se transcodifica
    # a MP3 320k con etiquetas (y portada si la subió antes a /relay/:id/cover)
    # y queda en el almacén común como un /tracks/:id más.
    put endpoint("/relay/:id", string id, File audio, string title = "", string artist = "", string album = "", int duration_ms = 0, string search_norm = "", string title_norm = "", string artist_norm = ""):
        if not id_valido(id):
            return { "error": "invalid_id" }.status(400)
        if title.trim() == "" or audio.size < 16384:
            return { "error": "invalid" }.status(400)
        # una pista que ya existe no se sobrescribe (sería pisar el audio de otra persona)
        if len(await sqlite.query("select 1 from tracks where id = ?", id)) > 0:
            os.remove_file("./data/relay/" + id + ".jpg")
            return { "stored": false, "id": id }
        # la identidad manda: si otro cliente ya aportó esta canción, no se duplica
        string igual = id_por_identidad(title_norm, artist_norm, duration_ms)
        if igual != "":
            os.remove_file("./data/relay/" + id + ".jpg")
            return { "stored": false, "id": igual, "duplicate": true }

        os.make_dir("data/relay")
        string raw = "./data/relay/" + id + ".raw"
        # sin esto, reintentar tras un fallo transcodificaba el .raw VIEJO (save() no sobrescribe)
        os.remove_file(raw)
        audio.save("./data/relay", id + ".raw")

        # ¿qué es lo que ha traído? (ffprobe; si falla, se asume webm)
        string contenedor = ""
        Json pr = await os.run("ffprobe", [
            "-v", "error", "-show_entries", "format=format_name",
            "-of", "json", raw
        ])
        Json? probe = jint(pr["status"], 1) == 0 ? parse_json(jstr(pr["stdout"], "")) : null
        if probe != null:
            contenedor = jstr(jget(jget(probe, "format"), "format_name"), "")

        os.make_dir("data/audio")
        string destino = "./data/audio/" + id + ".mp3"
        string portada = "./data/relay/" + id + ".jpg"
        bool tiene_portada = os.is_file(portada) and os.file_size(portada) > 100
        bool ok = false
        if contenedor.contains("mp3"):
            # ya es mp3: tal cual
            await os.move(raw, destino)
            ok = os.is_file(destino) and os.file_size(destino) >= 16384
        else:
            List<string> args = ["-y", "-v", "error", "-i", raw]
            if tiene_portada:
                args = args + ["-i", portada, "-map", "0:a", "-map", "1:v", "-c:v", "copy",
                               "-metadata:s:v", "title=Album cover", "-metadata:s:v", "comment=Cover (front)"]
            else:
                args.add("-vn")
            args = args + ["-c:a", "libmp3lame", "-b:a", "320k",
                           "-id3v2_version", "3", "-write_id3v1", "1",
                           "-map_metadata", "-1",
                           "-metadata", "title=" + title.trim()]
            if artist.trim() != "":
                args = args + ["-metadata", "artist=" + artist.trim()]
            if album.trim() != "":
                args = args + ["-metadata", "album=" + album.trim()]
            args.add(destino)
            Json fr = await os.run("ffmpeg", args)
            ok = jint(fr["status"], 1) == 0 and os.is_file(destino) and os.file_size(destino) >= 16384
        os.remove_file(portada)
        if not ok:
            os.remove_file(destino)
            os.remove_file(raw)
            return { "error": "transcode_failed" }.status(502)
        os.remove_file(raw)

        await sqlite.exec("""
            insert into tracks(id, title, artist, album, duration_ms, search_norm, title_norm, artist_norm, ext, size, uploaded_by)
            values(?, ?, ?, ?, ?, ?, ?, ?, 'mp3', ?, ?)
            on conflict(id) do update set ext = 'mp3', size = excluded.size""",
            id, title.trim(), artist, album, duration_ms,
            search_norm.trim(), title_norm.trim(), artist_norm.trim(), os.file_size(destino), yo())
        return { "stored": true, "id": id, "ext": "mp3" }.status(201)

    # Portada opcional para incrustar en el relay (se sube ANTES del audio).
    put endpoint("/relay/:id/cover", string id, File cover):
        if not id_valido(id) or cover.size < 100:
            return { "error": "invalid" }.status(400)
        os.make_dir("data/relay")
        os.remove_file("./data/relay/" + id + ".jpg")   # save() no sobrescribe (ver /me/avatar)
        cover.save("./data/relay", id + ".jpg")
        return { "ok": true }

    # ── mi biblioteca (la nube del usuario) ──
    # Da de alta pistas en mi biblioteca por identidad: [{id, titleNorm, artistNorm, durationMs, favorite}]
    # -> { registered, missing: [ids de cliente que el servidor aún no tiene] }
    put endpoint("/library", Json b):
        List<Json> items = b["items"] == null ? [] : b["items"]
        int registradas = 0
        List<string> faltan = []
        for int i in range(0, len(items)):
            if i >= 200:
                break
            string cid = s_of(items[i], "id", "")
            string sid = id_de_referencia(cid, s_of(items[i], "titleNorm", ""), s_of(items[i], "artistNorm", ""), i_of(items[i], "durationMs", 0))
            if sid == "":
                faltan.add(cid)
                continue
            int fav = items[i]["favorite"] == true ? 1 : 0
            await sqlite.exec("""
                insert into user_tracks(user_id, track_id, favorite) values(?, ?, ?)
                on conflict(user_id, track_id) do update set favorite = max(favorite, excluded.favorite)""", yo(), sid, fav)
            registradas = registradas + 1
        return { "registered": registradas, "missing": faltan }

    get endpoint("/library"):
        List<Json> r = await sqlite.query("""
            select t.id, t.title, t.artist, t.album, t.duration_ms, t.title_norm, t.artist_norm, u.favorite
            from user_tracks u join tracks t on t.id = u.track_id
            where u.user_id = ? order by u.added_at""", yo())
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add({ "id": r[i]["id"], "title": r[i]["title"], "artist": r[i]["artist"], "album": r[i]["album"],
                      "durationMs": r[i]["duration_ms"], "titleNorm": r[i]["title_norm"], "artistNorm": r[i]["artist_norm"],
                      "favorite": int(r[i]["favorite"]) == 1 })
        return out

    # Historial de escucha (alimenta Inicio en todos mis equipos): por identidad, como la biblioteca.
    # POST [{id, titleNorm, artistNorm, durationMs, playedAt, completed}] -> { stored }
    post endpoint("/plays", Json b):
        List<Json> items = b["items"] == null ? [] : b["items"]
        int guardadas = 0
        for int i in range(0, len(items)):
            if i >= 500:
                break
            string sid = id_de_referencia(s_of(items[i], "id", ""), s_of(items[i], "titleNorm", ""), s_of(items[i], "artistNorm", ""), i_of(items[i], "durationMs", 0))
            if sid == "":
                continue
            await sqlite.exec("""insert into plays(user_id, track_id, played_at, completed, ms_played) values(?, ?, ?, ?, ?)
                on conflict(user_id, track_id, played_at) do update set ms_played = max(ms_played, excluded.ms_played), completed = max(completed, excluded.completed)""",
                yo(), sid, i_of(items[i], "playedAt", 0), items[i]["completed"] == true ? 1 : 0, i_of(items[i], "msPlayed", 0))
            guardadas = guardadas + 1
        return { "stored": guardadas }

    # Mis escuchas posteriores a `since` (90 días como mucho), con lo necesario para casarlas en el cliente
    get endpoint("/plays", int since = 0):
        List<Json> r = await sqlite.query("""
            select t.id, t.title_norm, t.artist_norm, t.duration_ms, p.played_at, p.completed, p.ms_played
            from plays p join tracks t on t.id = p.track_id
            where p.user_id = ? and p.played_at > max(?, unixepoch() - 7776000)
            order by p.played_at limit 2000""", yo(), since)
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add({ "id": r[i]["id"], "titleNorm": r[i]["title_norm"], "artistNorm": r[i]["artist_norm"],
                      "durationMs": r[i]["duration_ms"], "playedAt": r[i]["played_at"], "completed": int(r[i]["completed"]) == 1,
                      "msPlayed": r[i]["ms_played"] })
        return out

    # Favorita (o no) por identidad: la pista del cliente puede tener otro id que la del servidor
    put endpoint("/library/favorite", Json b):
        string sid = id_de_referencia(s_of(b, "id", ""), s_of(b, "titleNorm", ""), s_of(b, "artistNorm", ""), i_of(b, "durationMs", 0))
        if sid == "":
            return status(404)
        await sqlite.exec("update user_tracks set favorite = ? where user_id = ? and track_id = ?", b["favorite"] == true ? 1 : 0, yo(), sid)
        return status(204)

    # Quitar de mi biblioteca (el audio compartido se queda: es de todos)
    post endpoint("/library/remove", Json b):
        string sid = id_de_referencia(s_of(b, "id", ""), s_of(b, "titleNorm", ""), s_of(b, "artistNorm", ""), i_of(b, "durationMs", 0))
        if sid != "":
            await sqlite.exec("delete from user_tracks where user_id = ? and track_id = ?", yo(), sid)
        return status(204)

    # ── playlists ──
    # invitaciones pendientes para mí
    get endpoint("/invitations"):
        List<Json> r = await sqlite.query("""
            select p.id, p.name, u.username as owner, u.display_name as owner_name
            from playlist_members m join playlists p on p.id = m.playlist_id join users u on u.id = p.owner_id
            where m.user_id = ? and m.status = 'pending' order by p.updated_at desc""", yo())
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add({ "id": r[i]["id"], "name": r[i]["name"], "owner": r[i]["owner"], "ownerName": r[i]["owner_name"] })
        return out

    # acepto: entro en la playlist (ya cuenta como miembro)
    post endpoint("/playlists/:id/accept", int id):
        List<Json> r = await sqlite.query("select 1 from playlist_members where playlist_id = ? and user_id = ? and status = 'pending'", id, yo())
        if len(r) == 0:
            return status(404)
        await sqlite.exec("update playlist_members set status = 'accepted' where playlist_id = ? and user_id = ?", id, yo())
        await sqlite.exec("update playlists set updated_at = unixepoch() where id = ?", id)
        return status(204)

    # rechazo: borra la invitación (no es salir de una playlist que ya tenía)
    delete endpoint("/playlists/:id/invitation", int id):
        await sqlite.exec("delete from playlist_members where playlist_id = ? and user_id = ? and status = 'pending'", id, yo())
        return status(204)

    # ids de playlists mías (o compartidas conmigo) que se borraron
    get endpoint("/playlist-tombstones"):
        List<Json> r = await sqlite.query("select playlist_id from playlist_tombstones where user_id = ?", yo())
        List<int> out = []
        for int i in range(0, len(r)):
            out.add(int(r[i]["playlist_id"]))
        return out

    get endpoint("/playlists"):
        List<Json> r = await sqlite.query(sql_resumen() + """
            where p.owner_id = ? or p.id in (select playlist_id from playlist_members where user_id = ? and status = 'accepted')
            order by p.updated_at desc""", yo(), yo())
        List<Json> out = []
        for int i in range(0, len(r)):
            out.add(playlist_resumen(r[i]))
        return out

    post endpoint("/playlists", Json b):
        string nombre = s_of(b, "name", "").trim()
        if nombre == "":
            return { "error": "invalid" }.status(400)
        string vis = s_of(b, "visibility", "private") == "public" ? "public" : "private"
        await sqlite.exec("insert into playlists(owner_id, name, description, visibility, collaborative) values(?, ?, ?, ?, ?)",
            yo(), nombre, s_of(b, "description", ""), vis, b["collaborative"] == true ? 1 : 0)
        int pid = await sqlite.last_id()
        if b["tracks"] != null:
            escribir_pistas(pid, b["tracks"], yo())
        return { "id": pid }.status(201)

    get endpoint("/playlists/:id", int id):
        string nivel = acceso(id, yo())
        if nivel == "":
            return status(404)
        List<Json> r = await sqlite.query(sql_resumen() + " where p.id = ?", id)
        Json dto = playlist_resumen(r[0])
        dto["access"] = nivel
        List<Json> ts = await sqlite.query("""
            select pt.track_id, pt.title, pt.artist, pt.album, pt.duration_ms, pt.title_norm, pt.artist_norm,
                   u.username as added_by
            from playlist_tracks pt left join users u on u.id = pt.added_by
            where pt.playlist_id = ? order by pt.position""", id)
        List<Json> tracks = []
        for int i in range(0, len(ts)):
            # serverId: la pista del servidor que equivale a esta referencia (puede
            # tener otro id si la subió otra persona), "" si no la tiene
            string sid = id_de_referencia(str(ts[i]["track_id"]), str(ts[i]["title_norm"]), str(ts[i]["artist_norm"]), int(ts[i]["duration_ms"]))
            tracks.add({ "id": ts[i]["track_id"], "title": ts[i]["title"], "artist": ts[i]["artist"],
                         "album": ts[i]["album"], "durationMs": ts[i]["duration_ms"],
                         "titleNorm": ts[i]["title_norm"], "artistNorm": ts[i]["artist_norm"],
                         "addedBy": ts[i]["added_by"], "available": sid != "", "serverId": sid })
        dto["tracks"] = tracks
        List<Json> ms = await sqlite.query("select u.username, u.display_name, m.status from playlist_members m join users u on u.id = m.user_id where m.playlist_id = ?", id)
        List<Json> members = []
        for int i in range(0, len(ms)):
            members.add({ "username": ms[i]["username"], "displayName": ms[i]["display_name"], "status": ms[i]["status"] })
        dto["members"] = members
        return dto

    put endpoint("/playlists/:id", int id, Json b):
        string nivel = acceso(id, yo())
        if nivel == "":
            return status(404)
        if nivel == "owner":
            string vis = s_of(b, "visibility", "") == "public" ? "public" : "private"
            await sqlite.exec("""
                update playlists set name = coalesce(nullif(?, ''), name), description = ?, visibility = ?, collaborative = ?,
                       updated_at = unixepoch() where id = ?""",
                s_of(b, "name", "").trim(), s_of(b, "description", ""), vis, b["collaborative"] == true ? 1 : 0, id)
        if b["tracks"] != null:
            if not puede_editar_pistas(nivel):
                return status(403)
            escribir_pistas(id, b["tracks"], yo())
        return status(204)

    # portada propia de la playlist: la sube su dueña, la ven quienes tienen acceso
    put endpoint("/playlists/:id/cover", int id, File cover):
        if acceso(id, yo()) != "owner" or cover.size < 100:
            return status(404)
        os.make_dir("data/pcovers")
        os.remove_file("./data/pcovers/" + str(id) + ".jpg")   # save() no sobrescribe (ver /me/avatar)
        cover.save("./data/pcovers", str(id) + ".jpg")
        return status(204)

    get endpoint("/playlists/:id/cover", int id):
        if acceso(id, yo()) == "" or not os.is_file("./data/pcovers/" + str(id) + ".jpg"):
            return status(404)
        return send_file("./data/pcovers/" + str(id) + ".jpg")

    delete endpoint("/playlists/:id", int id):
        if acceso(id, yo()) != "owner":
            return status(404)
        await sqlite.exec("insert or ignore into playlist_tombstones(user_id, playlist_id) select owner_id, id from playlists where id = ?", id)
        await sqlite.exec("insert or ignore into playlist_tombstones(user_id, playlist_id) select user_id, playlist_id from playlist_members where playlist_id = ?", id)
        await sqlite.exec("delete from playlists where id = ?", id)
        return status(204)

    # añadir pistas sin reescribir la lista (varios miembros a la vez)
    post endpoint("/playlists/:id/tracks", int id, Json b):
        if not puede_editar_pistas(acceso(id, yo())):
            return status(403)
        List<Json> nuevas = b["tracks"] == null ? [] : b["tracks"]
        for int i in range(0, len(nuevas)):
            insertar_pista(id, nuevas[i], yo())
        await sqlite.exec("update playlists set updated_at = unixepoch() where id = ?", id)
        return status(204)

    delete endpoint("/playlists/:id/tracks/:tid", int id, string tid):
        if not puede_editar_pistas(acceso(id, yo())):
            return status(403)
        await sqlite.exec("delete from playlist_tracks where playlist_id = ? and track_id = ?", id, tid)
        await sqlite.exec("update playlists set updated_at = unixepoch() where id = ?", id)
        return status(204)

    post endpoint("/playlists/:id/members", int id, Json b):
        if acceso(id, yo()) != "owner":
            return status(404)
        List<Json> u = await sqlite.query("select id from users where username = ?", s_of(b, "username", ""))
        if len(u) == 0:
            return { "error": "user_not_found" }.status(404)
        # invitar a la propia dueña no tiene sentido; y un tope razonable de invitados
        List<Json> dueno = await sqlite.query("select 1 from playlists where id = ? and owner_id = ?", id, int(u[0]["id"]))
        if len(dueno) > 0:
            return { "error": "invalid" }.status(400)
        List<Json> n = await sqlite.query("select count(*) as n from playlist_members where playlist_id = ?", id)
        if int(n[0]["n"]) >= 30:
            return { "error": "too_many" }.status(400)
        # una invitación queda pendiente hasta que la persona la acepta
        await sqlite.exec("insert or ignore into playlist_members(playlist_id, user_id, status) values(?, ?, 'pending')", id, int(u[0]["id"]))
        await sqlite.exec("update playlists set updated_at = unixepoch() where id = ?", id)
        return status(204)

    delete endpoint("/playlists/:id/members/:name", int id, string name):
        string nivel = acceso(id, yo())
        List<Json> me = await sqlite.query("select username from users where id = ?", yo())
        # el dueño echa a cualquiera; un miembro solo puede salirse
        if nivel != "owner" and not (nivel == "member" and str(me[0]["username"]).lower() == name.lower()):
            return status(403)
        await sqlite.exec("delete from playlist_members where playlist_id = ? and user_id = (select id from users where username = ?)", id, name)
        return status(204)
